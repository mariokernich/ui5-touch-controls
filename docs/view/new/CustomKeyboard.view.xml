<mvc:View
    controllerName="ui5.touch.controls.demo.controller.new.CustomKeyboard"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:control="ui5.touch.controls.demo.control"
    xmlns:f="sap.f"
    xmlns:cards="sap.f.cards"
    xmlns:tc="ui5.touch.controls"
    height="100%"
>
    <f:DynamicPage
        headerExpanded="true"
        class="touchControlsPage"
    >
        <!-- the head of the page reads like an entry of the demo kit: the name
		     of the class, one or two sentences on what it is, and beside them
		     the facts about the class -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title
                        text="{control>/fullName}"
                        wrapping="true"
                    />
                </f:heading>
                <f:expandedContent>
                    <Text text="{control>/summary}" />
                </f:expandedContent>
                <f:snappedContent>
                    <Text text="{control>/summary}" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <!-- the facts about the class, the way the demo kit lists them -->
                <HBox wrap="Wrap">
                    <!-- the base class is either one of sap.ui.core - then it
                         links into the demo kit - or one of this library,
                         which has a page here -->
                    <ObjectAttribute
                        title="{i18n>introExtends}"
                        text="{control>/extendsClass}"
                        class="sapUiMediumMarginEnd"
                        visible="{= !${control>/extendsUrl} &amp;&amp; !${control>/extendsKey} }"
                    />
                    <HBox
                    	alignItems="Center"
                    	wrap="Wrap"
                    	visible="{= !!${control>/extendsUrl} }"
                    	class="touchControlsFact sapUiMediumMarginEnd">
                    	<Text
                    		text="{= ${i18n>introExtends} + ':' }"
                    		class="touchControlsFactTitle" />
                    	<control:LinkList external="true">
                    		<Link
                    			text="{control>/extendsClass}"
                    			href="{control>/extendsUrl}"
                    			target="_blank" />
                    	</control:LinkList>
                    </HBox>
                    <ObjectAttribute
                        title="{i18n>introExtends}"
                        class="sapUiMediumMarginEnd"
                        visible="{= !${control>/extendsUrl} &amp;&amp; !!${control>/extendsKey} }"
                    >
                        <customContent>
                            <Link
                                text="{control>/extendsClass}"
                                press=".onNavToExtends"
                            />
                        </customContent>
                    </ObjectAttribute>
                    <HBox
                    	alignItems="Center"
                    	wrap="Wrap"
                    	visible="{control>/showOriginal}"
                    	class="touchControlsFact sapUiMediumMarginEnd">
                    	<Text
                    		text="{= ${i18n>introOriginalLabel} + ':' }"
                    		class="touchControlsFactTitle" />
                    	<control:LinkList external="{= !!${control>/docUrl} }">
                    		<Link
                    			text="{control>/replaces}"
                    			href="{control>/docUrl}"
                    			target="_blank"
                    			enabled="{= !!${control>/docUrl} }" />
                    	</control:LinkList>
                    </HBox>
                    <ObjectAttribute
                        title="{i18n>introSince}"
                        text="{control>/since}"
                        class="sapUiMediumMarginEnd"
                    />
                    <ObjectAttribute
                        title="{i18n>introVisibility}"
                        text="{control>/visibility}"
                        class="sapUiMediumMarginEnd" />
                    <!-- A class is written in more than one file - what it does and what
                         it looks like - so this fact carries a link per file, written as
                         an enumeration. -->
                    <HBox
                    	alignItems="Center"
                    	wrap="Wrap"
                    	class="touchControlsFact">
                    	<Text
                    		text="{= ${i18n>introSource} + ':' }"
                    		class="touchControlsFactTitle" />
                    	<control:LinkList external="true" links="{control>/sources}">
                    		<Link
                    			text="{control>file}"
                    			href="{control>url}"
                    			target="_blank" />
                    	</control:LinkList>
                    </HBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox width="100%">
                <!-- overview: the class in running text, longer than the summary
				     in the head of the page -->
                <Text
                    text="{control>/description}"
                    class="sapUiSmallMarginBottom"
                />
                <!-- what this keyboard is, and when to reach for one of the others -->
                <f:Card class="sapUiMediumMarginBottom">
                    <f:header>
                        <cards:Header title="{i18n>customIntroSubtitle}" />
                    </f:header>
                    <f:content>
                        <VBox
                            width="100%"
                            class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        >
                            <FormattedText
                                htmlText="{i18n>customIntroText}"
                                width="100%"
                                class="sapUiTinyMarginTop"
                            />
                        </VBox>
                    </f:content>
                </f:Card>
                <HBox
                    width="100%"
                    class="touchControlsCardRow"
                >
                    <!-- playground -->
                    <f:Card class="sapUiMediumMarginBottom">
                        <f:layoutData>
                            <FlexItemData
                                growFactor="1"
                                baseSize="0"
                            />
                        </f:layoutData>
                        <f:header>
                            <cards:Header title="{i18n>optionsCustomKeyboard}" />
                        </f:header>
                        <f:content>
                            <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <core:Fragment
                                    fragmentName="ui5.touch.controls.demo.view.SizeOption"
                                    type="XML"
                                />
                                <HBox alignItems="Center">
                                    <Text
                                        text="{i18n>lblValue}"
                                        width="130px"
                                    />
                                    <Input
                                        value="{json>/value}"
                                        valueLiveUpdate="true"
                                        width="150px"
                                    />
                                </HBox>
                                <HBox alignItems="Center">
                                    <Text
                                        text="{i18n>lblExample}"
                                        width="130px"
                                    />
                                    <Select
                                        selectedKey="{json>/example}"
                                        change=".onExampleChange"
                                        width="150px"
                                    >
                                        <core:Item
                                            key="plate"
                                            text="{i18n>exPlate}"
                                        />
                                        <core:Item
                                            key="sizes"
                                            text="{i18n>exSizes}"
                                        />
                                        <core:Item
                                            key="sets"
                                            text="{i18n>exSets}"
                                        />
                                    </Select>
                                </HBox>
                                <HBox alignItems="Start">
                                    <Text
                                        text="{i18n>lblLayout}"
                                        width="130px"
                                        class="sapUiTinyMarginTop"
                                    />
                                    <TextArea
                                        value="{json>/layoutText}"
                                        placeholder="{i18n>phLayout}"
                                        enabled="{= ${json>/example} !== 'sets' }"
                                        rows="4"
                                        growing="true"
                                        change=".applyLayout"
                                        width="240px"
                                    />
                                </HBox>
                                <HBox alignItems="Center">
                                    <Text
                                        text="{i18n>lblWidth}"
                                        width="130px"
                                    />
                                    <Input
                                        value="{json>/width}"
                                        placeholder="{i18n>phWidth}"
                                        valueLiveUpdate="true"
                                        width="150px"
                                    />
                                </HBox>
                                <HBox
                                    alignItems="Center"
                                    wrap="Wrap"
                                >
                                    <Text
                                        text="{i18n>lblBehavior}"
                                        width="130px"
                                    />
                                    <CheckBox
                                        text="{i18n>cbEnabled}"
                                        selected="{json>/enabled}"
                                    />
                                    <CheckBox
                                        text="{i18n>cbHardwareKeys}"
                                        selected="{json>/hardwareKeys}"
                                    />
                                    <CheckBox
                                        text="{i18n>cbDocked}"
                                        selected="{json>/docked}"
                                    />
                                </HBox>
                                <HBox alignItems="Center">
                                    <Text
                                        text="{i18n>lblLastEvent}"
                                        width="130px"
                                    />
                                    <Text text="{json>/lastEvent}" />
                                </HBox>
                            </VBox>
                        </f:content>
                    </f:Card>
                    <!-- the library control -->
                    <f:Card class="sapUiMediumMarginBottom">
                        <f:layoutData>
                            <FlexItemData
                                growFactor="2"
                                baseSize="0"
                            />
                        </f:layoutData>
                        <f:header>
                            <cards:Header title="ui5.touch.controls.CustomKeyboard" />
                        </f:header>
                        <f:content>
                            <VBox
                                width="100%"
                                class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <Text
                                    text="{i18n>vkHardwareKeysTip}"
                                    class="sapUiTinyMarginBottom"
                                />
                                <tc:CustomKeyboard
                                    id="keyboard"
                                    value="{json>/value}"
                                    size="{json>/size}"
                                    enabled="{json>/enabled}"
                                    hardwareKeys="{json>/hardwareKeys}"
                                    docked="{json>/docked}"
                                    width="{json>/width}"
                                    change=".onChange"
                                    enter=".onEnter"
                                />
                            </VBox>
                        </f:content>
                    </f:Card>
                </HBox>
                <!-- the API: what the control is set with, what it fires, what goes inside it -->
                <core:Fragment
                    fragmentName="ui5.touch.controls.demo.view.ApiCards"
                    type="XML"
                />
                <!-- how a layout is written -->
                <f:Card class="sapUiMediumMarginBottom">
                    <f:header>
                        <cards:Header
                            title="{i18n>customKeysTitle}"
                            subtitle="{i18n>customKeysSubtitle}"
                        />
                    </f:header>
                    <f:content>
                        <VBox
                            width="100%"
                            class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        >
                            <FormattedText
                                htmlText="{i18n>customKeysText}"
                                width="100%"
                                class="sapUiTinyMarginTop"
                            />
                            <Table items="{json>/specialKeys}">
                                <columns>
                                    <Column width="8rem">
                                        <Label text="{i18n>colKey}" />
                                    </Column>
                                    <Column
                                        demandPopin="true"
                                        minScreenWidth="Tablet"
                                        popinDisplay="Inline"
                                    >
                                        <Label text="{i18n>colKeyMeaning}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <Text text="{json>key}" />
                                        <Text text="{json>meaning}" />
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </f:content>
                </f:Card>
                <core:Fragment
                    fragmentName="ui5.touch.controls.demo.view.ExampleCard"
                    type="XML"
                />
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
