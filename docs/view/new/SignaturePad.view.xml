<mvc:View
    controllerName="ui5.touch.controls.demo.controller.new.SignaturePad"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:cards="sap.f.cards"
    xmlns:tc="ui5.touch.controls"
    height="100%"
>
    <f:DynamicPage
        headerExpanded="true"
        class="touchControlsPage"
    >
        <!-- the head of the page reads like an entry of the demo kit: the name
		     of the class, one or two sentences on what it is, and beside them
		     the facts about the class -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title
                        text="{control>/fullName}"
                        wrapping="true"
                    />
                </f:heading>
                <f:expandedContent>
                    <Text text="{control>/summary}" />
                </f:expandedContent>
                <f:snappedContent>
                    <Text text="{control>/summary}" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <!-- the facts about the class, the way the demo kit lists them -->
                <HBox wrap="Wrap">
                    <ObjectAttribute
                        title="{i18n>introExtends}"
                        class="sapUiMediumMarginEnd"
                    >
                        <customContent>
                            <Link
                                text="{control>/extendsClass}"
                                href="{control>/extendsUrl}"
                                target="_blank"
                                enabled="{= !!${control>/extendsUrl} }"
                            />
                        </customContent>
                    </ObjectAttribute>
                    <ObjectAttribute
                        title="{i18n>introOriginalLabel}"
                        class="sapUiMediumMarginEnd"
                        visible="{control>/showOriginal}"
                    >
                        <customContent>
                            <Link
                                text="{control>/replaces}"
                                href="{control>/docUrl}"
                                target="_blank"
                                enabled="{= !!${control>/docUrl} }"
                            />
                        </customContent>
                    </ObjectAttribute>
                    <ObjectAttribute
                        title="{i18n>introSince}"
                        text="{control>/since}"
                        class="sapUiMediumMarginEnd"
                    />
                    <ObjectAttribute
                        title="{i18n>introVisibility}"
                        text="{control>/visibility}"
                        class="sapUiMediumMarginEnd" />
                    <!-- A class is written in more than one file - what it does and what
                         it looks like - so the fact carries a link per file.

                         It is built by hand rather than from an ObjectAttribute like the
                         facts beside it: that one takes a single sap.m.Link in its
                         customContent and rejects a row of them at runtime, and one
                         attribute per file would either repeat the name of the fact or,
                         left without a title, hide itself. The name takes the colour a
                         label has, which is the one an attribute title takes too. -->
                    <HBox
                    	alignItems="Center"
                    	wrap="Wrap"
                    	class="touchControlsSource">
                    	<Text
                    		text="{= ${i18n>introSource} + ':' }"
                    		class="touchControlsSourceTitle" />
                    	<HBox
                    		items="{control>/sources}"
                    		wrap="Wrap"
                    		class="touchControlsSourceLinks">
                    		<Link
                    			text="{control>file}"
                    			href="{control>url}"
                    			target="_blank" />
                    	</HBox>
                    </HBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox width="100%">
                <!-- overview: the class in running text, longer than the summary
				     in the head of the page -->
                <Text
                    text="{control>/description}"
                    class="sapUiSmallMarginBottom"
                />
                <HBox
                    width="100%"
                    class="touchControlsCardRow"
                >
                    <!-- playground -->
                    <f:Card class="sapUiMediumMarginBottom">
                        <f:layoutData>
                            <FlexItemData
                                growFactor="1"
                                baseSize="0"
                            />
                        </f:layoutData>
                        <f:header>
                            <cards:Header title="{i18n>optionsSignaturePad}" />
                        </f:header>
                        <f:content>
                            <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <core:Fragment
                                    fragmentName="ui5.touch.controls.demo.view.SizeOption"
                                    type="XML"
                                />
                                <HBox alignItems="Center">
                                    <Text
                                        text="{i18n>lblHeight}"
                                        width="120px"
                                    />
                                    <Select selectedKey="{json>/height}">
                                        <core:Item
                                            key="8rem"
                                            text="8rem"
                                        />
                                        <core:Item
                                            key="12rem"
                                            text="12rem"
                                        />
                                        <core:Item
                                            key="16rem"
                                            text="16rem"
                                        />
                                        <core:Item
                                            key="24rem"
                                            text="24rem"
                                        />
                                    </Select>
                                </HBox>
                                <core:Fragment
                                    fragmentName="ui5.touch.controls.demo.view.ValueStateOption"
                                    type="XML"
                                />
                                <HBox alignItems="Center">
                                    <Text
                                        text="{i18n>lblBehavior}"
                                        width="120px"
                                    />
                                    <CheckBox
                                        text="{i18n>cbEnabled}"
                                        selected="{json>/enabled}"
                                    />
                                    <CheckBox
                                        text="{i18n>cbClearButton}"
                                        selected="{json>/showClearButton}"
                                    />
                                </HBox>
                                <HBox alignItems="Center">
                                    <Text
                                        text="{i18n>lblSigned}"
                                        width="120px"
                                    />
                                    <Text text="{json>/signed}" />
                                </HBox>
                                <HBox alignItems="Center">
                                    <Text
                                        text="{i18n>lblDataUrl}"
                                        width="120px"
                                    />
                                    <Text text="{json>/length} {i18n>spCharacters}" />
                                </HBox>
                            </VBox>
                        </f:content>
                    </f:Card>
                    <!-- the library control -->
                    <f:Card class="sapUiMediumMarginBottom">
                        <f:layoutData>
                            <FlexItemData
                                growFactor="2"
                                baseSize="0"
                            />
                        </f:layoutData>
                        <f:header>
                            <cards:Header
                                title="ui5.touch.controls.SignaturePad"
                                subtitle="{i18n>spSubtitle}"
                            />
                        </f:header>
                        <f:content>
                            <VBox
                                width="100%"
                                class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <tc:SignaturePad
                                    value="{json>/value}"
                                    placeholder="{json>/placeholder}"
                                    height="{json>/height}"
                                    size="{json>/size}"
                                    enabled="{json>/enabled}"
                                    showClearButton="{json>/showClearButton}"
                                    valueState="{json>/valueState}"
                                    change=".onChange"
                                />
                                <FormattedText
                                    htmlText="{i18n>signatureHint}"
                                    width="100%"
                                    class="sapUiTinyMarginTop"
                                />
                            </VBox>
                        </f:content>
                    </f:Card>
                    <!-- what the control writes into the model -->
                    <f:Card class="sapUiMediumMarginBottom">
                        <f:layoutData>
                            <FlexItemData
                                growFactor="1"
                                baseSize="0"
                            />
                        </f:layoutData>
                        <f:header>
                            <cards:Header
                                title="{i18n>spValueTitle}"
                                subtitle="{i18n>spValueSubtitle}"
                            />
                        </f:header>
                        <f:content>
                            <VBox
                                width="100%"
                                class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <Image
                                    src="{json>/preview}"
                                    width="100%"
                                    densityAware="false"
                                    visible="{json>/signed}"
                                />
                                <Text
                                    text="{i18n>spNothingSigned}"
                                    visible="{= !${json>/signed} }"
                                />
                            </VBox>
                        </f:content>
                    </f:Card>
                </HBox>
                <core:Fragment
                    fragmentName="ui5.touch.controls.demo.view.ExampleCard"
                    type="XML"
                />
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
