<mvc:View
	controllerName="ui5.touch.controls.demo.controller.Changelog"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards">

		<f:DynamicPage>
      <f:title>
				<f:DynamicPageTitle>
					<f:heading>
						<Title text="Changelog"/>
					</f:heading>
          </f:DynamicPageTitle>
          </f:title>
<f:header>
				<f:DynamicPageHeader pinnable="false">
					<!-- the texts of this page are English only, see model/changelog.ts -->
					<Text
						text="What changed in every release of the library, the newest first." />
				</f:DynamicPageHeader>
		</f:header>
      <f:content>
		<VBox width="100%" items="{changelog>/releases}">
			<f:Card class="sapUiMediumMarginBottom">
				<f:header>
					<!-- the header clamps its subtitle to two lines by default, which
					     on a phone cuts a summary off in the middle -->
					<cards:Header
						title="{changelog>version}"
						subtitle="{changelog>summary}"
						subtitleMaxLines="0"
						statusText="{= ${changelog>date} || 'Unreleased' }" />
				</f:header>
				<f:content>
					<!-- the template of a binding that sits inside another binding is
					     cloned with it, so it is not shared and has to say so -
					     otherwise the framework leaves the clones behind -->
					<VBox
						width="100%"
						items="{path: 'changelog>groups', templateShareable: false}"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<VBox class="sapUiSmallMarginTop">
							<Title text="{changelog>kind}" level="H3" wrapping="true" />
							<!-- the entries are plain strings, so the row binds the
							     context itself -->
							<VBox
								items="{path: 'changelog>items', templateShareable: false}"
								class="sapUiTinyMarginTop">
								<HBox class="touchControlsBullet">
									<Text text="•" class="sapUiTinyMarginEnd" />
									<Text text="{changelog>}" />
								</HBox>
							</VBox>
						</VBox>
					</VBox>
				</f:content>
			</f:Card>
		</VBox>
    </f:content>
	</f:DynamicPage>
</mvc:View>
