<mvc:View
	controllerName="ui5.touch.controls.demo.controller.Text"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ControlIntro"
			type="XML" />

		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="{i18n>optionsText}" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblText}" width="100px" />
							<Input
								value="{json>/text}"
								placeholder="{i18n>lblText}"
								valueLiveUpdate="true"
								width="300px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblColor}" width="100px" />
							<Input
								value="{json>/color}"
								placeholder="{i18n>phColor}"
								valueLiveUpdate="true"
								width="200px" />
							<Button
								icon="sap-icon://color-fill"
								tooltip="{i18n>tooltipChooseColor}"
								press=".onColorPress"
								class="sapUiTinyMarginBegin" />
						</HBox>
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="ui5.touch.controls.Text"
						subtitle="{i18n>cardTouch}" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<tc:Text
							text="{json>/text}"
							color="{json>/color}"
							size="{json>/size}"
							press=".onTextPress" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the sap.m original -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="sap.m.Text"
						subtitle="{i18n>cardOriginal}" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Text text="{json>/text}" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
