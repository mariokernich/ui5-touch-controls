<mvc:View
	controllerName="ui5.touch.controls.demo.controller.general.Setup"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:control="ui5.touch.controls.demo.control"
	height="100%">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>setupTitle}" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<Text text="{i18n>setupSubtitle}" />
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox width="100%">
				<!-- prerequisites -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>setupPrereqTitle}"
							subtitle="{i18n>setupPrereqSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<MessageStrip
								text="{i18n>setupPrereqStrip}"
								type="Information"
								showIcon="true" />
							<FormattedText
								htmlText="{i18n>setupPrereqText}"
								width="100%"
								class="sapUiTinyMarginTop" />
						</VBox>
					</f:content>
				</f:Card>

				<!-- installation -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>setupInstallTitle}"
							subtitle="{i18n>setupInstallSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>setupInstallText}"
								width="100%" />
							<VBox width="100%" items="{example>/install}">
								<f:Card class="sapUiSmallMarginTop">
									<f:header>
										<cards:Header title="{example>title}" />
									</f:header>
									<f:content>
										<control:CodeBlock
											text="{example>code}"
											language="{example>language}"
											class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
									</f:content>
								</f:Card>
							</VBox>
						</VBox>
					</f:content>
				</f:Card>

				<!-- tooling / middleware -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>setupMiddlewareTitle}"
							subtitle="{i188n>setupMiddlewareSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>setupMiddlewareText}"
								width="100%" />
							<VBox width="100%" items="{example>/middleware}">
								<f:Card class="sapUiSmallMarginTop">
									<f:header>
										<cards:Header title="{example>title}" />
									</f:header>
									<f:content>
										<control:CodeBlock
											text="{example>code}"
											language="{example>language}"
											class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
									</f:content>
								</f:Card>
							</VBox>
						</VBox>
					</f:content>
				</f:Card>

				<!-- manifest -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>setupManifestTitle}"
							subtitle="{i18n>setupManifestSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
							items="{example>/manifest}">
							<f:Card class="sapUiSmallMarginTop">
								<f:header>
									<cards:Header title="{example>title}" />
								</f:header>
								<f:content>
									<control:CodeBlock
										text="{example>code}"
										language="{example>language}"
										class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
								</f:content>
							</f:Card>
						</VBox>
					</f:content>
				</f:Card>

				<!-- namespace -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>setupNamespaceTitle}"
							subtitle="{i18n>setupNamespaceSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
							items="{example>/namespace}">
							<f:Card class="sapUiSmallMarginTop">
								<f:header>
									<cards:Header title="{i18n>exampleUsageXml}" />
								</f:header>
								<f:content>
									<control:CodeBlock
										text="{example>code}"
										language="{example>language}"
										class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
								</f:content>
							</f:Card>
						</VBox>
					</f:content>
				</f:Card>

				<!-- TypeScript -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>setupTypeScriptTitle}"
							subtitle="{i18n>setupTypeScriptSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<MessageStrip
								text="{i18n>setupTypeScriptStrip}"
								type="Warning"
								showIcon="true" />
							<FormattedText
								htmlText="{i18n>setupTypeScriptText}"
								width="100%"
								class="sapUiTinyMarginTop" />
							<VBox width="100%" items="{example>/typescript}">
								<f:Card class="sapUiSmallMarginTop">
									<f:header>
										<cards:Header title="{example>title}" />
									</f:header>
									<f:content>
										<control:CodeBlock
											text="{example>code}"
											language="{example>language}"
											class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
									</f:content>
								</f:Card>
							</VBox>
						</VBox>
					</f:content>
				</f:Card>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
