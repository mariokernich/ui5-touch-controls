<mvc:View
	controllerName="ui5.touch.controls.demo.controller.general.Setup"
	xmlns="sap.uxap"
	xmlns:m="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:control="ui5.touch.controls.demo.control"
	height="100%">
	<ObjectPageLayout
		id="objectPage"
		upperCaseAnchorBar="false"
		showFooter="true"
		class="touchControlsPage touchControlsObjectPage">
		<headerTitle>
			<ObjectPageHeader
				objectTitle="{i18n>setupTitle}"
				objectSubtitle="{i18n>setupSubtitle}" />
		</headerTitle>
		<sections>
			<ObjectPageSection title="{i18n>setupPrereqTitle}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<m:VBox width="100%">
								<m:Text
									text="{i18n>setupPrereqSubtitle}"
									class="touchControlsSectionLead sapUiTinyMarginBottom" />
								<m:MessageStrip
									text="{i18n>setupPrereqStrip}"
									type="Information"
									showIcon="true" />
								<m:FormattedText
									htmlText="{i18n>setupPrereqText}"
									width="100%"
									class="sapUiTinyMarginTop" />
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			<ObjectPageSection title="{i18n>setupInstallTitle}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<m:VBox width="100%">
								<m:Text
									text="{i18n>setupInstallSubtitle}"
									class="touchControlsSectionLead" />
								<m:FormattedText
									htmlText="{i18n>setupInstallText}"
									width="100%"
									class="sapUiTinyMarginTop" />
								<m:VBox width="100%" items="{example>/install}">
									<f:Card class="sapUiSmallMarginTop">
										<f:header>
											<cards:Header title="{example>title}" />
										</f:header>
										<f:content>
											<control:CodeBlock
												text="{example>code}"
												language="{example>language}"
												class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
										</f:content>
									</f:Card>
								</m:VBox>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			<ObjectPageSection title="{i18n>setupMiddlewareTitle}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<m:VBox width="100%">
								<m:Text
									text="{i18n>setupMiddlewareSubtitle}"
									class="touchControlsSectionLead" />
								<m:FormattedText
									htmlText="{i18n>setupMiddlewareText}"
									width="100%"
									class="sapUiTinyMarginTop" />
								<m:VBox width="100%" items="{example>/middleware}">
									<f:Card class="sapUiSmallMarginTop">
										<f:header>
											<cards:Header title="{example>title}" />
										</f:header>
										<f:content>
											<control:CodeBlock
												text="{example>code}"
												language="{example>language}"
												class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
										</f:content>
									</f:Card>
								</m:VBox>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			<ObjectPageSection title="{i18n>setupManifestTitle}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<m:VBox width="100%">
								<m:Text
									text="{i18n>setupManifestSubtitle}"
									class="touchControlsSectionLead" />
								<m:VBox width="100%" items="{example>/manifest}">
									<f:Card class="sapUiSmallMarginTop">
										<f:header>
											<cards:Header title="{example>title}" />
										</f:header>
										<f:content>
											<control:CodeBlock
												text="{example>code}"
												language="{example>language}"
												class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
										</f:content>
									</f:Card>
								</m:VBox>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			<ObjectPageSection title="{i18n>setupNamespaceTitle}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<m:VBox width="100%">
								<m:Text
									text="{i18n>setupNamespaceSubtitle}"
									class="touchControlsSectionLead" />
								<m:VBox width="100%" items="{example>/namespace}">
									<f:Card class="sapUiSmallMarginTop">
										<f:header>
											<cards:Header title="{i18n>exampleUsageXml}" />
										</f:header>
										<f:content>
											<control:CodeBlock
												text="{example>code}"
												language="{example>language}"
												class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
										</f:content>
									</f:Card>
								</m:VBox>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
			<ObjectPageSection title="{i18n>setupTypeScriptTitle}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<m:VBox width="100%">
								<m:Text
									text="{i18n>setupTypeScriptSubtitle}"
									class="touchControlsSectionLead sapUiTinyMarginBottom" />
								<m:MessageStrip
									text="{i18n>setupTypeScriptStrip}"
									type="Warning"
									showIcon="true" />
								<m:FormattedText
									htmlText="{i18n>setupTypeScriptText}"
									width="100%"
									class="sapUiTinyMarginTop" />
								<m:VBox width="100%" items="{example>/typescript}">
									<f:Card class="sapUiSmallMarginTop">
										<f:header>
											<cards:Header title="{example>title}" />
										</f:header>
										<f:content>
											<control:CodeBlock
												text="{example>code}"
												language="{example>language}"
												class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
										</f:content>
									</f:Card>
								</m:VBox>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
	</ObjectPageLayout>
</mvc:View>
