<mvc:View
	controllerName="ui5.touch.controls.demo.controller.general.Documentation"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:control="ui5.touch.controls.demo.control"
	height="100%">
	<f:DynamicPage toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>docTitle}" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<Text text="{i18n>docSubtitle}" />
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox width="100%">
				<!-- touch versions of sap.m controls -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>docPortedTitle}"
							subtitle="{i18n>docPortedSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>docPortedText}"
								width="100%" />
							<Table items="{docs>/ported}" class="sapUiSmallMarginTop">
								<columns>
									<Column width="12rem">
										<Label text="{i18n>colControl}" />
									</Column>
									<Column
										width="14rem"
										demandPopin="true"
										minScreenWidth="Tablet"
										popinDisplay="Inline">
										<Label text="{i18n>colReplaces}" />
									</Column>
									<Column
										demandPopin="true"
										minScreenWidth="Tablet"
										popinDisplay="Inline">
										<Label text="{i18n>colDescription}" />
									</Column>
								</columns>
								<items>
									<ColumnListItem>
										<Link
											text="tc:{docs>name}"
											tooltip="{i18n>tooltipOpenControlPage}"
											press=".onControlPress" />
										<Text text="{docs>replaces}" />
										<Text text="{docs>description}" />
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</f:content>
				</f:Card>

				<!-- additional controls for touch, with no sap.m equivalent -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>docNewTitle}"
							subtitle="{i18n>docNewSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>docNewText}"
								width="100%" />
							<!-- the Replaces column would say the same thing in every
							     row, so it is left out here -->
							<Table items="{docs>/new}" class="sapUiSmallMarginTop">
								<columns>
									<Column width="12rem">
										<Label text="{i18n>colControl}" />
									</Column>
									<Column
										demandPopin="true"
										minScreenWidth="Tablet"
										popinDisplay="Inline">
										<Label text="{i18n>colDescription}" />
									</Column>
								</columns>
								<items>
									<ColumnListItem>
										<Link
											text="tc:{docs>name}"
											tooltip="{i18n>tooltipOpenControlPage}"
											press=".onControlPress" />
										<Text text="{docs>description}" />
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</f:content>
				</f:Card>

				<!-- what is called from a controller instead of put into a view -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>docClassesTitle}"
							subtitle="{i18n>docClassesSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>docClassesText}"
								width="100%" />
							<Table items="{docs>/classes}" class="sapUiSmallMarginTop">
								<columns>
									<Column width="12rem">
										<Label text="{i18n>colClass}" />
									</Column>
									<Column
										width="14rem"
										demandPopin="true"
										minScreenWidth="Tablet"
										popinDisplay="Inline">
										<Label text="{i18n>colReplaces}" />
									</Column>
									<Column
										demandPopin="true"
										minScreenWidth="Tablet"
										popinDisplay="Inline">
										<Label text="{i18n>colDescription}" />
									</Column>
								</columns>
								<items>
									<ColumnListItem>
										<Link
											text="tc:{docs>name}"
											tooltip="{i18n>tooltipOpenControlPage}"
											press=".onControlPress" />
										<Text text="{docs>replaces}" />
										<Text text="{docs>description}" />
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</f:content>
				</f:Card>

				<!-- theme compatibility -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>docThemesTitle}"
							subtitle="{i18n>docThemesSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>docThemesText1}"
								width="100%" />
							<Table items="{docs>/themes}" class="sapUiSmallMarginTop">
								<columns>
									<Column width="18rem">
										<Label text="{i18n>colTheme}" />
									</Column>
									<Column
										width="14rem"
										demandPopin="true"
										minScreenWidth="Tablet"
										popinDisplay="Inline">
										<Label text="{i18n>colThemeId}" />
									</Column>
									<Column
										width="10rem"
										demandPopin="true"
										minScreenWidth="Tablet"
										popinDisplay="Inline">
										<Label text="{i18n>colSupported}" />
									</Column>
									<Column
										demandPopin="true"
										minScreenWidth="Tablet"
										popinDisplay="Inline">
										<Label text="{i18n>colRemark}" />
									</Column>
								</columns>
								<items>
									<ColumnListItem>
										<Text text="{docs>name}" />
										<Text text="{docs>id}" />
										<ObjectStatus
											text="{= ${docs>supported} ? ${i18n>yes} : ${i18n>no} }"
											state="{= ${docs>supported} ? 'Success' : 'Error' }"
											icon="{= ${docs>supported} ? 'sap-icon://accept' : 'sap-icon://decline' }" />
										<Text text="{docs>note}" />
									</ColumnListItem>
								</items>
							</Table>
							<FormattedText
								htmlText="{i18n>docThemesText2}"
								width="100%"
								class="sapUiSmallMarginTop" />
						</VBox>
					</f:content>
				</f:Card>

				<!-- sizes -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>docSizesTitle}"
							subtitle="{i18n>docSizesSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>docSizesText1}"
								width="100%" />
							<FormattedText
								htmlText="{i18n>docSizesText2}"
								width="100%"
								class="sapUiSmallMarginTop" />
							<!-- the snippets keep their card: it is what sets code
							     apart from the prose around it -->
							<VBox width="100%" items="{example>/sizes}">
								<f:Card class="sapUiSmallMarginTop">
									<f:header>
										<cards:Header title="{i18n>docSizesExample}" />
									</f:header>
									<f:content>
										<control:CodeBlock
											text="{example>code}"
											language="{example>language}"
											class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
									</f:content>
								</f:Card>
							</VBox>
						</VBox>
					</f:content>
				</f:Card>

				<!-- ISized -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>docISizedTitle}"
							subtitle="{i18n>docISizedSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>docISizedText}"
								width="100%" />
							<VBox width="100%" items="{example>/isized}">
								<f:Card class="sapUiSmallMarginTop">
									<f:header>
										<cards:Header title="{i18n>exampleUsageController}" />
									</f:header>
									<f:content>
										<control:CodeBlock
											text="{example>code}"
											language="{example>language}"
											class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
									</f:content>
								</f:Card>
							</VBox>
						</VBox>
					</f:content>
				</f:Card>

				<!-- the three keyboards -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>docKeyboardTitle}"
							subtitle="{i18n>docKeyboardSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<FormattedText
								htmlText="{i18n>docKeyboardText1}"
								width="100%" />
							<FormattedText
								htmlText="{i18n>docKeyboardText2}"
								width="100%"
								class="sapUiSmallMarginTop" />
							<VBox width="100%" items="{example>/keyboard}">
								<f:Card class="sapUiSmallMarginTop">
									<f:header>
										<cards:Header title="{i18n>exampleUsageXml}" />
									</f:header>
									<f:content>
										<control:CodeBlock
											text="{example>code}"
											language="{example>language}"
											class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
									</f:content>
								</f:Card>
							</VBox>
						</VBox>
					</f:content>
				</f:Card>

				<!-- pitfall: aggregations that only accept sap.m.Button -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<cards:Header
							title="{i18n>docPitfallTitle}"
							subtitle="{i18n>docPitfallSubtitle}"
							subtitleMaxLines="0" />
					</f:header>
					<f:content>
						<VBox
							width="100%"
							class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
							<MessageStrip
								text="{i18n>docPitfallStrip}"
								type="Warning"
								showIcon="true" />
							<FormattedText
								htmlText="{i18n>docPitfallText1}"
								width="100%"
								class="sapUiSmallMarginTop" />
							<VBox width="100%" items="{example>/pitfallBroken}">
								<f:Card class="sapUiSmallMarginTop">
									<f:header>
										<cards:Header title="{i18n>docPitfallBrokenTitle}" />
									</f:header>
									<f:content>
										<control:CodeBlock
											text="{example>code}"
											language="{example>language}"
											class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
									</f:content>
								</f:Card>
							</VBox>
							<FormattedText
								htmlText="{i18n>docPitfallText2}"
								width="100%"
								class="sapUiSmallMarginTop" />
							<VBox width="100%" items="{example>/pitfallWorks}">
								<f:Card class="sapUiSmallMarginTop">
									<f:header>
										<cards:Header title="{i18n>docPitfallWorksTitle}" />
									</f:header>
									<f:content>
										<control:CodeBlock
											text="{example>code}"
											language="{example>language}"
											class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
									</f:content>
								</f:Card>
							</VBox>
							<FormattedText
								htmlText="{i18n>docPitfallText3}"
								width="100%"
								class="sapUiSmallMarginTop" />
						</VBox>
					</f:content>
				</f:Card>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
