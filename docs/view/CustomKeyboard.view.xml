<mvc:View
	controllerName="ui5.touch.controls.demo.controller.CustomKeyboard"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<!-- what this keyboard is, and when to reach for one of the others -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{control>/fullName}"
					subtitle="{i18n>customIntroSubtitle}"
					subtitleMaxLines="0" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>customIntroText}"
						width="100%"
						class="sapUiTinyMarginTop" />
				</VBox>
			</f:content>
		</f:Card>

		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="{i18n>optionsCustomKeyboard}" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment
							fragmentName="ui5.touch.controls.demo.view.SizeOption"
							type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblValue}" width="130px" />
							<Input
								value="{json>/value}"
								valueLiveUpdate="true"
								width="150px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblExample}" width="130px" />
							<Select selectedKey="{json>/example}" change=".onExampleChange" width="150px">
								<core:Item key="plate" text="{i18n>exPlate}" />
								<core:Item key="sizes" text="{i18n>exSizes}" />
								<core:Item key="sets" text="{i18n>exSets}" />
							</Select>
						</HBox>
						<HBox alignItems="Start">
							<Text
								text="{i18n>lblLayout}"
								width="130px"
								class="sapUiTinyMarginTop" />
							<TextArea
								value="{json>/layoutText}"
								placeholder="{i18n>phLayout}"
								enabled="{= ${json>/example} !== 'sets' }"
								rows="4"
								growing="true"
								change=".applyLayout"
								width="240px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblWidth}" width="130px" />
							<Input
								value="{json>/width}"
								placeholder="{i18n>phWidth}"
								valueLiveUpdate="true"
								width="150px" />
						</HBox>
						<HBox alignItems="Center" wrap="Wrap">
							<Text text="{i18n>lblBehavior}" width="130px" />
							<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
							<CheckBox
								text="{i18n>cbHardwareKeys}"
								selected="{json>/hardwareKeys}" />
							<CheckBox text="{i18n>cbDocked}" selected="{json>/docked}" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblLastEvent}" width="130px" />
							<Text text="{json>/lastEvent}" />
						</HBox>
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="2" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="ui5.touch.controls.CustomKeyboard" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Text
							text="{i18n>vkHardwareKeysTip}"
							class="sapUiTinyMarginBottom" />
						<tc:CustomKeyboard
							id="keyboard"
							value="{json>/value}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							hardwareKeys="{json>/hardwareKeys}"
							docked="{json>/docked}"
							width="{json>/width}"
							change=".onChange"
							enter=".onEnter" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<!-- how a layout is written -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>customKeysTitle}"
					subtitle="{i18n>customKeysSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>customKeysText}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<Table items="{json>/specialKeys}">
						<columns>
							<Column width="8rem">
								<Label text="{i18n>colKey}" />
							</Column>
							<Column
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colKeyMeaning}" />
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<Text text="{json>key}" />
								<Text text="{json>meaning}" />
							</ColumnListItem>
						</items>
					</Table>
				</VBox>
			</f:content>
		</f:Card>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
