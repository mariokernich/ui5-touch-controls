<mvc:View
	controllerName="ui5.touch.controls.demo.controller.Setup"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:editor="sap.ui.codeeditor">
	<Page showHeader="false" class="touchControlsPage">
		<VBox class="sapUiSmallMarginBottom">
			<Title text="{i18n>setupTitle}" level="H1" wrapping="true" />
			<Text text="{i18n>setupSubtitle}" class="sapUiTinyMarginTop" />
		</VBox>

		<!-- prerequisites -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>setupPrereqTitle}"
					subtitle="{i18n>setupPrereqSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<MessageStrip
						text="{i18n>setupPrereqStrip}"
						type="Information"
						showIcon="true" />
					<FormattedText
						htmlText="{i18n>setupPrereqText}"
						width="100%"
						class="sapUiTinyMarginTop" />
				</VBox>
			</f:content>
		</f:Card>

		<!-- 1. install -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>setupInstallTitle}"
					subtitle="{i18n>setupInstallSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>setupInstallText}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<VBox width="100%" items="{example>/install}">
						<f:Card class="sapUiMediumMarginTop">
							<f:header>
								<cards:Header title="{example>title}" />
							</f:header>
							<f:content>
								<editor:CodeEditor
									value="{example>code}"
									type="{example>language}"
									height="{example>height}"
									width="100%"
									editable="false"
									lineNumbers="true"
									class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
							</f:content>
						</f:Card>
					</VBox>
				</VBox>
			</f:content>
		</f:Card>

		<!-- 1b. middleware -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>setupMiddlewareTitle}"
					subtitle="{i18n>setupMiddlewareSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>setupMiddlewareText}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<VBox width="100%" items="{example>/middleware}">
						<f:Card class="sapUiMediumMarginTop">
							<f:header>
								<cards:Header title="{example>title}" />
							</f:header>
							<f:content>
								<editor:CodeEditor
									value="{example>code}"
									type="{example>language}"
									height="{example>height}"
									width="100%"
									editable="false"
									lineNumbers="true"
									class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
							</f:content>
						</f:Card>
					</VBox>
				</VBox>
			</f:content>
		</f:Card>

		<!-- 2. manifest -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>setupManifestTitle}"
					subtitle="{i18n>setupManifestSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
					items="{example>/manifest}">
					<f:Card class="sapUiMediumMarginTop">
						<f:header>
							<cards:Header title="{example>title}" />
						</f:header>
						<f:content>
							<editor:CodeEditor
								value="{example>code}"
								type="{example>language}"
								height="{example>height}"
								width="100%"
								editable="false"
								lineNumbers="true"
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
						</f:content>
					</f:Card>
				</VBox>
			</f:content>
		</f:Card>

		<!-- 3. namespace -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>setupNamespaceTitle}"
					subtitle="{i18n>setupNamespaceSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom"
					items="{example>/namespace}">
					<f:Card class="sapUiMediumMarginTop">
						<f:header>
							<cards:Header title="{i18n>exampleUsageXml}" />
						</f:header>
						<f:content>
							<editor:CodeEditor
								value="{example>code}"
								type="{example>language}"
								height="{example>height}"
								width="100%"
								editable="false"
								lineNumbers="true"
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
						</f:content>
					</f:Card>
				</VBox>
			</f:content>
		</f:Card>

		<!-- 4. typescript -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>setupTypeScriptTitle}"
					subtitle="{i18n>setupTypeScriptSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<MessageStrip
						text="{i18n>setupTypeScriptStrip}"
						type="Warning"
						showIcon="true" />
					<FormattedText
						htmlText="{i18n>setupTypeScriptText}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<VBox width="100%" items="{example>/typescript}">
						<f:Card class="sapUiMediumMarginTop">
							<f:header>
								<cards:Header title="{example>title}" />
							</f:header>
							<f:content>
								<editor:CodeEditor
									value="{example>code}"
									type="{example>language}"
									height="{example>height}"
									width="100%"
									editable="false"
									lineNumbers="true"
									class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
							</f:content>
						</f:Card>
					</VBox>
				</VBox>
			</f:content>
		</f:Card>

		<HBox
			wrap="Wrap"
			alignItems="Center"
			class="touchControlsButtonRow sapUiSmallMarginBottom">
			<Button
				text="{i18n>navGettingStarted}"
				icon="sap-icon://navigation-left-arrow"
				press=".onGettingStartedPress" />
			<Button
				text="{i18n>navDocumentation}"
				icon="sap-icon://navigation-right-arrow"
				iconFirst="false"
				type="Emphasized"
				press=".onDocumentationPress" />
		</HBox>
	</Page>
</mvc:View>
