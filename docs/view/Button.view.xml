<mvc:View
	controllerName="ui5.touch.controls.demo.controller.Button"
	xmlns="sap.uxap"
	xmlns:m="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:control="ui5.touch.controls.demo.control"
	xmlns:tc="ui5.touch.controls"
	core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	height="100%">
	<!-- Alternative page concept: instead of a sap.m.Page filled with a row of
	     sap.f.Cards, the page of a control is an ObjectPageLayout. The anchor
	     bar then names the parts of the page - Overview, Playground, Example
	     Usage - and jumps to them, which a row of cards cannot do.

	     The head of the page reads like an entry of the demo kit: the name of
	     the control, one or two sentences on what it is, and beside them the
	     facts about the class - what it extends, since when it is there and
	     how visible it is. -->
	<ObjectPageLayout
		id="objectPage"
		upperCaseAnchorBar="false"
		class="touchControlsPage touchControlsObjectPage">
		<!-- showTitleInHeaderContent is left off on purpose: it repeats the
		     title and subtitle of the header title inside the header content,
		     so the head of the page would say the same thing twice -->
		<headerTitle>
			<ObjectPageHeader
				objectTitle="{control>/fullName}"
				objectSubtitle="{control>/summary}" />
		</headerTitle>

		<headerContent>
			<!-- the facts about the class, the way the demo kit lists them -->
			<m:ObjectAttribute title="{i18n>introExtends}">
				<m:customContent>
					<m:Link
						text="{control>/extendsClass}"
						href="{control>/extendsUrl}"
						target="_blank"
						enabled="{= !!${control>/extendsUrl} }" />
				</m:customContent>
			</m:ObjectAttribute>
			<!-- the link to the demo kit reads like the attribute beside it -
			     "Original: sap.m.Button" - instead of being a bare "read more" -->
			<m:ObjectAttribute title="{i18n>introOriginalLabel}">
				<m:customContent>
					<m:Link
						text="{control>/replaces}"
						href="{control>/docUrl}"
						target="_blank"
						enabled="{= !!${control>/docUrl} }" />
				</m:customContent>
			</m:ObjectAttribute>
			<m:ObjectAttribute title="{i18n>introSince}" text="{control>/since}" />
			<m:ObjectAttribute
				title="{i18n>introVisibility}"
				text="{control>/visibility}" />
		</headerContent>

		<sections>
			<!-- Overview: the control in running text, longer than the summary in
			     the head of the page -->
			<ObjectPageSection title="{i18n>sectionOverview}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<!-- running text rather than two columns: the headings
							     "The original" and "The touch version" were on every
							     page and said less than the sentences below them -->
							<m:VBox width="100%">
								<m:Text text="{control>/description}" />
								<m:Text
									text="{
										parts: ['i18n>overviewReplaces', 'control>/replaces', 'control>/original'],
										formatter: 'formatMessage'
									}"
									class="sapUiSmallMarginTop" />
								<m:Text
									text="{i18n>introSizeNote}"
									class="sapUiSmallMarginTop" />

							<m:MessageStrip
								text="{i18n>overviewBarHint}"
								type="Information"
								showIcon="true"
								class="sapUiSmallMarginTop">
								<m:link>
									<m:Link
										text="{i18n>overviewBarHintLink}"
										press=".onNavToOverflowToolbar" />
								</m:link>
							</m:MessageStrip>
              </m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<!-- Playground: one block, three columns - what can be set, the
			     control of this library, and the sap.m original beside it -->
			<ObjectPageSection title="{i18n>sectionPlayground}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<m:HBox
								width="100%"
								wrap="Wrap"
								class="touchControlsCardRow touchControlsPlaygroundRow">
								<!-- column 1: what can be set -->
								<m:VBox>
									<m:layoutData>
										<m:FlexItemData growFactor="1" baseSize="0" />
									</m:layoutData>
									<m:Title
										text="{i18n>optionsTitle}"
										level="H3"
										wrapping="true"
										class="sapUiTinyMarginBottom" />
									<core:Fragment
										fragmentName="ui5.touch.controls.demo.view.SizeOption"
										type="XML" />
									<m:HBox alignItems="Center">
										<m:Text text="{i18n>lblType}" width="100px" />
										<!-- the type is a plain list of the sap.m.ButtonType
										     values, so the same key can be set on both
										     buttons and compared -->
										<m:Select
											selectedKey="{json>/type}"
											items="{
												path: 'json>/types',
												templateShareable: false
											}">
											<core:Item key="{json>type}" text="{json>type}" />
										</m:Select>
									</m:HBox>
									<m:HBox alignItems="Center">
										<m:Text text="{i18n>lblText}" width="100px" />
										<m:Input
											value="{json>/text}"
											placeholder="{i18n>phButtonText}"
											valueLiveUpdate="true"
											width="200px" />
									</m:HBox>
									<m:HBox alignItems="Center">
										<m:Text text="{i18n>lblIcon}" width="100px" />
										<m:Input
											value="{json>/icon}"
											placeholder="{i18n>phButtonIcon}"
											valueLiveUpdate="true"
											width="300px" />
									</m:HBox>
									<m:HBox alignItems="Center" wrap="Wrap">
										<m:Text text="{i18n>lblBehavior}" width="100px" />
										<m:CheckBox
											text="{i18n>cbShowIcon}"
											selected="{json>/showIcon}"
											select=".onShowIconSelect" />
										<m:CheckBox
											text="{i18n>cbShowText}"
											selected="{json>/showText}"
											select=".onShowTextSelect" />
										<m:CheckBox
											text="{i18n>cbIconFirst}"
											selected="{json>/iconFirst}" />
										<m:CheckBox
											text="{i18n>cbEnabled}"
											selected="{json>/enabled}" />
									</m:HBox>
								</m:VBox>

								<!-- column 2: the library control -->
								<m:VBox>
									<m:layoutData>
										<m:FlexItemData growFactor="1" baseSize="0" />
									</m:layoutData>
									<m:Title
										text="{control>/fullName}"
										level="H3"
										wrapping="true" />
									<m:Text
										text="{i18n>cardTouch}"
										class="sapUiTinyMarginBottom" />
									<!-- one button, the type comes from the option beside it:
									     the two columns are there to be compared, and a list
									     of every type on both sides makes that harder, not
									     easier -->
									<m:VBox alignItems="Start">
										<tc:Button
											text="{json>/text}"
											type="{json>/type}"
											icon="{json>/icon}"
											iconFirst="{json>/iconFirst}"
											enabled="{json>/enabled}"
											size="{json>/size}" />
									</m:VBox>
								</m:VBox>

								<!-- column 3: the sap.m original -->
								<m:VBox>
									<m:layoutData>
										<m:FlexItemData growFactor="1" baseSize="0" />
									</m:layoutData>
									<m:Title
										text="{control>/replaces}"
										level="H3"
										wrapping="true" />
									<m:Text
										text="{i18n>cardOriginal}"
										class="sapUiTinyMarginBottom" />
									<m:VBox alignItems="Start">
										<m:Button
											text="{json>/text}"
											type="{json>/type}"
											icon="{json>/icon}"
											iconFirst="{json>/iconFirst}"
											enabled="{json>/enabled}" />
									</m:VBox>
								</m:VBox>
							</m:HBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>

			<!-- Example Usage: the snippets come from the "example" model, not
			     from the view - curly braces in an XML view would be parsed as
			     binding syntax -->
			<ObjectPageSection title="{i18n>sectionExample}">
				<subSections>
					<ObjectPageSubSection>
						<blocks>
							<m:VBox width="100%" items="{example>/main}">
								<m:VBox width="100%">
									<m:Title
										text="{= ${example>title} || (${example>language} === 'xml' ? ${i18n>exampleUsageXml} : ${i18n>exampleUsageController}) }"
										level="H3"
										wrapping="true"
										class="sapUiTinyMarginBottom" />
									<control:CodeBlock
										text="{example>code}"
										language="{example>language}" />
								</m:VBox>
							</m:VBox>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
	</ObjectPageLayout>
</mvc:View>
