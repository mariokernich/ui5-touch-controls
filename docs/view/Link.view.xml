<mvc:View
	controllerName="ui5.touch.controls.demo.controller.Link"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ControlIntro"
			type="XML" />

		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="{i18n>optionsLink}" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblText}" width="100px" />
							<Input value="{json>/text}" valueLiveUpdate="true" width="260px" />
						</HBox>
						<HBox alignItems="Center" wrap="Wrap">
							<Text text="{i18n>lblBehavior}" width="100px" />
							<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
							<CheckBox text="{i18n>cbWrapping}" selected="{json>/wrapping}" />
							<CheckBox text="{i18n>cbSubtle}" selected="{json>/subtle}" />
							<CheckBox text="{i18n>cbEmphasized}" selected="{json>/emphasized}" />
						</HBox>
						<Text
							text="{i18n>linkSizeNote}"
							class="sapUiTinyMarginTop" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="ui5.touch.controls.Link"
						subtitle="{i18n>cardTouch}" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Title
							text="{i18n>linkWithPressHandler}"
							level="H6"
							class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
						<tc:Link
							text="{json>/text}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							wrapping="{json>/wrapping}"
							subtle="{json>/subtle}"
							emphasized="{json>/emphasized}"
							press=".onSizedPress" />

						<Title
							text="{i18n>linkWithHref}"
							level="H6"
							class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
						<tc:Link
							text="{json>/text}"
							href="{json>/repository}"
							target="_blank"
							size="{json>/size}"
							enabled="{json>/enabled}"
							wrapping="{json>/wrapping}"
							subtle="{json>/subtle}"
							emphasized="{json>/emphasized}" />

						<Title
							text="{i18n>linkTruncated}"
							level="H6"
							class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
						<tc:Link
							text="{json>/longText}"
							href="{json>/repository}"
							width="240px"
							size="{json>/size}"
							enabled="{json>/enabled}"
							wrapping="{json>/wrapping}" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the sap.m original -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="sap.m.Link"
						subtitle="{i18n>cardOriginal}" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Title
							text="{i18n>linkWithPressHandler}"
							level="H6"
							class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
						<Link
							text="{json>/text}"
							enabled="{json>/enabled}"
							wrapping="{json>/wrapping}"
							subtle="{json>/subtle}"
							emphasized="{json>/emphasized}"
							press=".onStandardPress" />

						<Title
							text="{i18n>linkWithHref}"
							level="H6"
							class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
						<Link
							text="{json>/text}"
							href="{json>/repository}"
							target="_blank"
							enabled="{json>/enabled}"
							wrapping="{json>/wrapping}"
							subtle="{json>/subtle}"
							emphasized="{json>/emphasized}" />

						<Title
							text="{i18n>linkTruncated}"
							level="H6"
							class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
						<Link
							text="{json>/longText}"
							href="{json>/repository}"
							width="240px"
							enabled="{json>/enabled}"
							wrapping="{json>/wrapping}" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
