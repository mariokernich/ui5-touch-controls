<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:control="ui5.touch.controls.demo.control">
	<!-- The snippets come from the "example" model instead of being written
	     into the view: curly braces in an XML view would be parsed as binding
	     syntax, so binding examples would swallow half of the code. -->
	<VBox width="100%" items="{example>/main}">
		<f:Card class="sapUiSmallMarginBottom">
			<f:header>
				<!-- without an explicit title the card falls back to a translated
				     default; binding it here instead of resolving it in the
				     controller keeps it following the language switch -->
				<cards:Header
					title="{= ${example>title} || (${example>language} === 'xml' ? ${i18n>exampleUsageXml} : ${i18n>exampleUsageController}) }" />
			</f:header>
			<f:content>
				<control:CodeBlock
					text="{example>code}"
					language="{example>language}"
					showCopyButton="true"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
			</f:content>
		</f:Card>
	</VBox>
</core:FragmentDefinition>
