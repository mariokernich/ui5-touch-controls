<mvc:View
	controllerName="ui5.touch.controls.demo.controller.TimePicker"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ControlIntro"
			type="XML" />

		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="{i18n>optionsTimePicker}" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblDisplayFormat}" width="110px" />
							<Select selectedKey="{json>/displayFormat}">
								<core:Item key="HH:mm" text="HH:mm" />
								<core:Item key="hh:mm a" text="hh:mm a" />
								<core:Item key="short" text="short" />
								<core:Item key="medium" text="medium" />
							</Select>
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblMinutesStep}" width="110px" />
							<StepInput value="{json>/minutesStep}" min="1" max="30" />
						</HBox>
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.ValueStateOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblBehavior}" width="110px" />
							<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
							<CheckBox text="{i18n>cbEditable}" selected="{json>/editable}" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblValue}" width="110px" />
							<Text text="{json>/value}" />
						</HBox>
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.LastEventOption" type="XML" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="ui5.touch.controls.TimePicker"
						subtitle="{i18n>cardTouch}" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<tc:TimePicker
							value="{json>/value}"
							displayFormat="{json>/displayFormat}"
							minutesStep="{json>/minutesStep}"
							placeholder="{i18n>phPickTime}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							width="14rem"
							change=".onChange" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the sap.m original -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="sap.m.TimePicker"
						subtitle="{i18n>cardOriginal}" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<TimePicker
							value="{json>/value}"
							valueFormat="HH:mm"
							displayFormat="{json>/displayFormat}"
							minutesStep="{json>/minutesStep}"
							placeholder="{i18n>phPickTime}"
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							width="14rem" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
