<mvc:View
	controllerName="ui5.touch.controls.demo.controller.VirtualKeyboard"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="{i18n>optionsVirtualKeyboard}" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment
							fragmentName="ui5.touch.controls.demo.view.SizeOption"
							type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblValue}" width="100px" />
							<Input
								value="{json>/value}"
								valueLiveUpdate="true"
								width="150px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblMode}" width="100px" />
							<!-- the entries are the values of the property, so they can be
							     copied straight into a view -->
							<Select selectedKey="{json>/mode}">
								<core:Item key="QWERTY" text="QWERTY" />
								<core:Item key="QWERTZ" text="QWERTZ" />
								<core:Item key="QWERTYMobile" text="QWERTYMobile" />
								<core:Item key="QWERTZMobile" text="QWERTZMobile" />
								<core:Item key="Numeric" text="Numeric" />
								<core:Item key="Phone" text="Phone" />
								<core:Item key="Calculator" text="Calculator" />
								<core:Item key="Custom" text="Custom" />
							</Select>
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblLayout}" width="100px" />
							<Input
								value="{json>/layoutText}"
								placeholder="{i18n>phLayout}"
								enabled="{= ${json>/mode} === 'Custom' }"
								change=".applyCustomLayout"
								width="240px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblWidth}" width="100px" />
							<Input
								value="{json>/width}"
								placeholder="{i18n>phWidth}"
								valueLiveUpdate="true"
								width="150px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblBehavior}" width="100px" />
							<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
							<CheckBox text="{i18n>cbHardwareKeys}" selected="{json>/hardwareKeys}" />
							<CheckBox text="{i18n>cbDocked}" selected="{json>/docked}" />
						</HBox>
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="2" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="ui5.touch.controls.VirtualKeyboard" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Text
							text="{i18n>vkHardwareKeysTip}"
							class="sapUiTinyMarginBottom" />
						<tc:VirtualKeyboard
							id="keyboard"
							value="{json>/value}"
							mode="{json>/mode}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							hardwareKeys="{json>/hardwareKeys}"
							docked="{json>/docked}"
							width="{json>/width}"
							change=".onChange"
							enter=".onEnter" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<!-- what the layouts of the playground are made of -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>keyboardLayoutsTitle}"
					subtitle="{i18n>keyboardLayoutsSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>keyboardLayoutsText}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<Table items="{json>/modes}">
						<columns>
							<Column width="10rem">
								<Label text="{i18n>colMode}" />
							</Column>
							<Column width="6rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
								<Label text="{i18n>colKeys}" />
							</Column>
							<Column demandPopin="true" minScreenWidth="Tablet" popinDisplay="Inline">
								<Label text="{i18n>colModeKeys}" />
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<Link
									text="{json>mode}"
									tooltip="{i18n>tooltipTryMode}"
									press=".onModePress" />
								<Text text="{json>keys}" />
								<Text text="{json>sample}" />
							</ColumnListItem>
						</items>
					</Table>
				</VBox>
			</f:content>
		</f:Card>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
