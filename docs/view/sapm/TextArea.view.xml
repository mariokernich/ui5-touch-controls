<mvc:View
	controllerName="ui5.touch.controls.demo.controller.sapm.TextArea"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:control="ui5.touch.controls.demo.control"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls"
	core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	height="100%">
	<f:DynamicPage
		headerExpanded="true"
		class="touchControlsPage">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{control>/fullName}" wrapping="true" />
				</f:heading>
				<f:expandedContent>
					<Text text="{i18n>docTextAreaSummary}" />
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{i18n>docTextAreaSummary}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<HBox wrap="Wrap">
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsFact sapUiMediumMarginEnd">
						<Text
							text="{= ${i18n>introExtends} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="{= !!${control>/extendsUrl} }">
							<Link
								text="{control>/extendsClass}"
								href="{control>/extendsUrl}"
								target="_blank"
								enabled="{= !!${control>/extendsUrl} }" />
						</control:LinkList>
					</HBox>
					<HBox
						alignItems="Center"
						wrap="Wrap"
						visible="{control>/showOriginal}"
						class="touchControlsFact sapUiMediumMarginEnd">
						<Text
							text="{= ${i18n>introOriginalLabel} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="{= !!${control>/docUrl} }">
							<Link
								text="{control>/replaces}"
								href="{control>/docUrl}"
								target="_blank"
								enabled="{= !!${control>/docUrl} }" />
						</control:LinkList>
					</HBox>
					<ObjectAttribute
						title="{i18n>introSince}"
						text="{control>/since}"
						class="sapUiMediumMarginEnd" />
					<ObjectAttribute
						title="{i18n>introVisibility}"
						text="{control>/visibility}"
						class="sapUiMediumMarginEnd" />
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsFact">
						<Text
							text="{= ${i18n>introSource} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="true" links="{control>/sources}">
							<Link
								text="{control>file}"
								href="{control>url}"
								target="_blank" />
						</control:LinkList>
					</HBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox width="100%">
				<Text text="{i18n>docTextAreaDescription}" />
				<Text
					text="{
						parts: ['i18n>overviewReplaces', 'control>/replaces', 'control>/original'],
						formatter: 'formatMessage'
					}"
					class="sapUiSmallMarginTop" />
				<Text
					text="{i18n>introSizeNote}"
					class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
				<HBox
					width="100%"
					wrap="Wrap"
					class="touchControlsCardRow touchControlsPlaygroundRow">
					<f:Card class="sapUiSmallMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header title="{i18n>optionsTitle}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
								<HBox alignItems="Center">
									<Text text="{i18n>lblPlaceholder}" width="100px" />
									<Input
										value="{json>/placeholder}"
										placeholder="{i18n>lblPlaceholder}"
										valueLiveUpdate="true"
										width="300px" />
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblRows}" width="100px" />
									<StepInput value="{json>/rows}" min="1" max="20" />
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblMaxLength}" width="100px" />
									<StepInput value="{json>/maxLength}" min="0" max="500" step="10" />
								</HBox>
								<core:Fragment fragmentName="ui5.touch.controls.demo.view.ValueStateOption" type="XML" />
								<HBox alignItems="Center" wrap="Wrap">
									<Text text="{i18n>lblBehavior}" width="100px" />
									<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
									<CheckBox text="{i18n>cbEditable}" selected="{json>/editable}" />
									<CheckBox
										text="{i18n>cbKeyboard}"
										selected="{json>/showKeyboard}" />
									<CheckBox
										text="{i18n>cbDocked}"
										selected="{json>/keyboardDocked}"
										enabled="{json>/showKeyboard}" />
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblMode}" width="100px" />
									<Select
										selectedKey="{json>/keyboardMode}"
										enabled="{json>/showKeyboard}">
										<core:Item key="English" text="English" />
										<core:Item key="German" text="German" />
										<core:Item key="French" text="French" />
										<core:Item key="Spanish" text="Spanish" />
										<core:Item key="Ukrainian" text="Ukrainian" />
										<core:Item key="Russian" text="Russian" />
										<core:Item key="Hindi" text="Hindi" />
									</Select>
								</HBox>
								<Text text="{i18n>textAreaKeyboardHint}" class="sapUiTinyMarginTop" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="sapUiSmallMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/fullName}"
								subtitle="{i18n>cardTouch}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<tc:TextArea
									value="{json>/value}"
									placeholder="{json>/placeholder}"
									rows="{json>/rows}"
									maxLength="{json>/maxLength}"
									size="{json>/size}"
									enabled="{json>/enabled}"
									editable="{json>/editable}"
									valueState="{json>/valueState}"
									showKeyboard="{json>/showKeyboard}"
									width="100%"
									liveChange=".onLiveChange">
									<tc:keyboard>
										<tc:Keyboard
											size="{json>/size}"
											mode="{json>/keyboardMode}"
											docked="{json>/keyboardDocked}" />
									</tc:keyboard>
								</tc:TextArea>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="sapUiSmallMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/replaces}"
								subtitle="{i18n>cardOriginal}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<TextArea
									value="{json>/value}"
									placeholder="{json>/placeholder}"
									rows="{json>/rows}"
									maxLength="{json>/maxLength}"
									enabled="{json>/enabled}"
									editable="{json>/editable}"
									valueState="{json>/valueState}"
									valueLiveUpdate="true"
									width="100%" />
							</VBox>
						</f:content>
					</f:Card>
				</HBox>
				<core:Fragment
					fragmentName="ui5.touch.controls.demo.view.ExampleCard"
					type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
