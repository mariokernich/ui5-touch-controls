<mvc:View
	controllerName="ui5.touch.controls.demo.controller.sapm.Link"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:control="ui5.touch.controls.demo.control"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls"
	core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	height="100%">
	<f:DynamicPage
		headerExpanded="true"
		class="touchControlsPage">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{control>/fullName}" wrapping="true" />
				</f:heading>
				<f:expandedContent>
					<Text text="{i18n>docLinkSummary}" />
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{i18n>docLinkSummary}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<HBox wrap="Wrap">
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsFact sapUiMediumMarginEnd">
						<Text
							text="{= ${i18n>introExtends} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="{= !!${control>/extendsUrl} }">
							<Link
								text="{control>/extendsClass}"
								href="{control>/extendsUrl}"
								target="_blank"
								enabled="{= !!${control>/extendsUrl} }" />
						</control:LinkList>
					</HBox>
					<HBox
						alignItems="Center"
						wrap="Wrap"
						visible="{control>/showOriginal}"
						class="touchControlsFact sapUiMediumMarginEnd">
						<Text
							text="{= ${i18n>introOriginalLabel} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="{= !!${control>/docUrl} }">
							<Link
								text="{control>/replaces}"
								href="{control>/docUrl}"
								target="_blank"
								enabled="{= !!${control>/docUrl} }" />
						</control:LinkList>
					</HBox>
					<ObjectAttribute
						title="{i18n>introSince}"
						text="{control>/since}"
						class="sapUiMediumMarginEnd" />
					<ObjectAttribute
						title="{i18n>introVisibility}"
						text="{control>/visibility}"
						class="sapUiMediumMarginEnd" />
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsFact">
						<Text
							text="{= ${i18n>introSource} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="true" links="{control>/sources}">
							<Link
								text="{control>file}"
								href="{control>url}"
								target="_blank" />
						</control:LinkList>
					</HBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox width="100%">
				<Text text="{i18n>docLinkDescription}" />
				<Text
					text="{
						parts: ['i18n>overviewReplaces', 'control>/replaces', 'control>/original'],
						formatter: 'formatMessage'
					}"
					class="sapUiSmallMarginTop" />
				<Text
					text="{i18n>introSizeNote}"
					class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
				<HBox
					width="100%"
					wrap="Wrap"
					class="touchControlsCardRow touchControlsPlaygroundRow">
					<f:Card class="sapUiSmallMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header title="{i18n>optionsTitle}" />
						</f:header>
						<f:content>
							<VBox
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<core:Fragment
									fragmentName="ui5.touch.controls.demo.view.SizeOption"
									type="XML" />
								<HBox alignItems="Center">
									<Text text="{i18n>lblText}" width="100px" />
									<Input value="{json>/text}" valueLiveUpdate="true" width="260px" />
								</HBox>
								<HBox alignItems="Center" wrap="Wrap">
									<Text text="{i18n>lblBehavior}" width="100px" />
									<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
									<CheckBox text="{i18n>cbWrapping}" selected="{json>/wrapping}" />
									<CheckBox text="{i18n>cbSubtle}" selected="{json>/subtle}" />
									<CheckBox text="{i18n>cbEmphasized}"
										selected="{json>/emphasized}" />
								</HBox>
								<Text
									text="{i18n>linkSizeNote}"
									class="sapUiTinyMarginTop" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="sapUiSmallMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/fullName}"
								subtitle="{i18n>cardTouch}" />
						</f:header>
						<f:content>
							<VBox
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<Title
									text="{i18n>linkWithPressHandler}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<tc:Link
									text="{json>/text}"
									size="{json>/size}"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}"
									subtle="{json>/subtle}"
									emphasized="{json>/emphasized}"
									press=".onSizedPress" />

								<Title
									text="{i18n>linkWithHref}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<tc:Link
									text="{json>/text}"
									href="{json>/repository}"
									target="_blank"
									size="{json>/size}"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}"
									subtle="{json>/subtle}"
									emphasized="{json>/emphasized}" />

								<Title
									text="{i18n>linkTruncated}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<tc:Link
									text="{json>/longText}"
									href="{json>/repository}"
									width="240px"
									size="{json>/size}"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="sapUiSmallMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/replaces}"
								subtitle="{i18n>cardOriginal}" />
						</f:header>
						<f:content>
							<VBox
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<Title
									text="{i18n>linkWithPressHandler}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<Link
									text="{json>/text}"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}"
									subtle="{json>/subtle}"
									emphasized="{json>/emphasized}"
									press=".onStandardPress" />
								<Title
									text="{i18n>linkWithHref}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<Link
									text="{json>/text}"
									href="{json>/repository}"
									target="_blank"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}"
									subtle="{json>/subtle}"
									emphasized="{json>/emphasized}" />

								<Title
									text="{i18n>linkTruncated}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<Link
									text="{json>/longText}"
									href="{json>/repository}"
									width="240px"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}" />
							</VBox>
						</f:content>
					</f:Card>
				</HBox>
				<core:Fragment
					fragmentName="ui5.touch.controls.demo.view.ExampleCard"
					type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
