<mvc:View
	controllerName="ui5.touch.controls.demo.controller.sapm.Link"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls"
	core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	height="100%">
	<f:DynamicPage
		headerExpanded="true"
		class="touchControlsPage">
		<!-- the head of the page reads like an entry of the demo kit: the name
		     of the class, one or two sentences on what it is, and beside them
		     the facts about the class -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{control>/fullName}" wrapping="true" />
				</f:heading>
				<f:expandedContent>
					<Text text="{control>/summary}" />
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{control>/summary}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<!-- the facts about the class, the way the demo kit lists them -->
				<HBox wrap="Wrap">
					<ObjectAttribute title="{i18n>introExtends}" class="sapUiMediumMarginEnd">
						<customContent>
							<Link
								text="{control>/extendsClass}"
								href="{control>/extendsUrl}"
								target="_blank"
								enabled="{= !!${control>/extendsUrl} }" />
						</customContent>
					</ObjectAttribute>
					<ObjectAttribute
						title="{i18n>introOriginalLabel}"
						class="sapUiMediumMarginEnd"
						visible="{control>/showOriginal}">
						<customContent>
							<Link
								text="{control>/replaces}"
								href="{control>/docUrl}"
								target="_blank"
								enabled="{= !!${control>/docUrl} }" />
						</customContent>
					</ObjectAttribute>
					<ObjectAttribute
						title="{i18n>introSince}"
						text="{control>/since}"
						class="sapUiMediumMarginEnd" />
					<ObjectAttribute
						title="{i18n>introVisibility}"
						text="{control>/visibility}"
						class="sapUiMediumMarginEnd" />
					<!-- where the class is written, for reading along in the repository -->
					<ObjectAttribute title="{i18n>introSource}">
						<customContent>
							<Link
								text="{control>/sourceFile}"
								href="{control>/sourceUrl}"
								target="_blank" />
						</customContent>
					</ObjectAttribute>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
			<VBox width="100%">
				<!-- overview: the class in running text, longer than the summary
				     in the head of the page -->
				<Text text="{control>/description}" />
				<Text
					text="{
						parts: ['i18n>overviewReplaces', 'control>/replaces', 'control>/original'],
						formatter: 'formatMessage'
					}"
					class="sapUiSmallMarginTop" />
				<Text
					text="{i18n>introSizeNote}"
					class="sapUiSmallMarginTop sapUiSmallMarginBottom" />

				<!-- playground: three cards - what can be set, the control of
				     this library, and the sap.m original beside it -->
				<HBox
					width="100%"
					wrap="Wrap"
					class="touchControlsCardRow touchControlsPlaygroundRow">
					<!-- card 1: what can be set -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header title="{i18n>optionsTitle}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
								<HBox alignItems="Center">
									<Text text="{i18n>lblText}" width="100px" />
									<Input value="{json>/text}" valueLiveUpdate="true" width="260px" />
								</HBox>
								<HBox alignItems="Center" wrap="Wrap">
									<Text text="{i18n>lblBehavior}" width="100px" />
									<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
									<CheckBox text="{i18n>cbWrapping}" selected="{json>/wrapping}" />
									<CheckBox text="{i18n>cbSubtle}" selected="{json>/subtle}" />
									<CheckBox text="{i18n>cbEmphasized}" selected="{json>/emphasized}" />
								</HBox>
								<Text
									text="{i18n>linkSizeNote}"
									class="sapUiTinyMarginTop" />
							</VBox>
						</f:content>
					</f:Card>

					<!-- card 2: the library control -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/fullName}"
								subtitle="{i18n>cardTouch}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<Title
									text="{i18n>linkWithPressHandler}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<tc:Link
									text="{json>/text}"
									size="{json>/size}"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}"
									subtle="{json>/subtle}"
									emphasized="{json>/emphasized}"
									press=".onSizedPress" />

								<Title
									text="{i18n>linkWithHref}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<tc:Link
									text="{json>/text}"
									href="{json>/repository}"
									target="_blank"
									size="{json>/size}"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}"
									subtle="{json>/subtle}"
									emphasized="{json>/emphasized}" />

								<Title
									text="{i18n>linkTruncated}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<tc:Link
									text="{json>/longText}"
									href="{json>/repository}"
									width="240px"
									size="{json>/size}"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}" />
							</VBox>
						</f:content>
					</f:Card>

					<!-- card 3: the sap.m original -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/replaces}"
								subtitle="{i18n>cardOriginal}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<Title
									text="{i18n>linkWithPressHandler}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<Link
									text="{json>/text}"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}"
									subtle="{json>/subtle}"
									emphasized="{json>/emphasized}"
									press=".onStandardPress" />

								<Title
									text="{i18n>linkWithHref}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<Link
									text="{json>/text}"
									href="{json>/repository}"
									target="_blank"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}"
									subtle="{json>/subtle}"
									emphasized="{json>/emphasized}" />

								<Title
									text="{i18n>linkTruncated}"
									level="H6"
									class="sapUiSmallMarginTop sapUiTinyMarginBottom" />
								<Link
									text="{json>/longText}"
									href="{json>/repository}"
									width="240px"
									enabled="{json>/enabled}"
									wrapping="{json>/wrapping}" />
							</VBox>
						</f:content>
					</f:Card>
				</HBox>

				<core:Fragment
					fragmentName="ui5.touch.controls.demo.view.ExampleCard"
					type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
