<mvc:View
	controllerName="ui5.touch.controls.demo.controller.sapm.Button"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls"
	core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	height="100%">
	<f:DynamicPage
		headerExpanded="true"
		class="touchControlsPage">
		<!-- the head of the page reads like an entry of the demo kit: the name
		     of the class, one or two sentences on what it is, and beside them
		     the facts about the class -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{control>/fullName}" wrapping="true" />
				</f:heading>
				<f:expandedContent>
					<Text text="{control>/summary}" />
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{control>/summary}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<!-- the facts about the class, the way the demo kit lists them -->
				<HBox wrap="Wrap">
					<ObjectAttribute title="{i18n>introExtends}" class="sapUiMediumMarginEnd">
						<customContent>
							<Link
								text="{control>/extendsClass}"
								href="{control>/extendsUrl}"
								target="_blank"
								enabled="{= !!${control>/extendsUrl} }" />
						</customContent>
					</ObjectAttribute>
					<ObjectAttribute
						title="{i18n>introOriginalLabel}"
						class="sapUiMediumMarginEnd"
						visible="{control>/showOriginal}">
						<customContent>
							<Link
								text="{control>/replaces}"
								href="{control>/docUrl}"
								target="_blank"
								enabled="{= !!${control>/docUrl} }" />
						</customContent>
					</ObjectAttribute>
					<ObjectAttribute
						title="{i18n>introSince}"
						text="{control>/since}"
						class="sapUiMediumMarginEnd" />
					<ObjectAttribute
						title="{i18n>introVisibility}"
						text="{control>/visibility}"
						class="sapUiMediumMarginEnd" />
					<!-- where the class is written, for reading along in the repository -->
					<ObjectAttribute title="{i18n>introSource}">
						<customContent>
							<Link
								text="{control>/sourceFile}"
								href="{control>/sourceUrl}"
								target="_blank" />
						</customContent>
					</ObjectAttribute>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
			<VBox width="100%">
				<!-- overview: the class in running text, longer than the summary
				     in the head of the page -->
				<Text text="{control>/description}" />
				<Text
					text="{
						parts: ['i18n>overviewReplaces', 'control>/replaces', 'control>/original'],
						formatter: 'formatMessage'
					}"
					class="sapUiSmallMarginTop" />
				<Text
					text="{i18n>introSizeNote}"
					class="sapUiSmallMarginTop" />
				<MessageStrip
					text="{i18n>overviewBarHint}"
					type="Information"
					showIcon="true"
					class="sapUiSmallMarginTop sapUiSmallMarginBottom">
					<link>
						<Link
							text="{i18n>overviewBarHintLink}"
							press=".onNavToOverflowToolbar" />
					</link>
				</MessageStrip>

				<!-- playground: three cards - what can be set, the control of
				     this library, and the sap.m original beside it -->
				<HBox
					width="100%"
					wrap="Wrap"
					class="touchControlsCardRow touchControlsPlaygroundRow">
					<!-- card 1: what can be set -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header title="{i18n>optionsTitle}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<core:Fragment
									fragmentName="ui5.touch.controls.demo.view.SizeOption"
									type="XML" />
								<HBox alignItems="Center">
									<Text text="{i18n>lblType}" width="100px" />
									<!-- the type is a plain list of the sap.m.ButtonType
									     values, so the same key can be set on both
									     buttons and compared -->
									<Select
										selectedKey="{json>/type}"
										items="{
											path: 'json>/types',
											templateShareable: false
										}">
										<core:Item key="{json>type}" text="{json>type}" />
									</Select>
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblText}" width="100px" />
									<Input
										value="{json>/text}"
										placeholder="{i18n>phButtonText}"
										valueLiveUpdate="true"
										width="200px" />
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblIcon}" width="100px" />
									<Input
										value="{json>/icon}"
										placeholder="{i18n>phButtonIcon}"
										valueLiveUpdate="true"
										width="300px" />
								</HBox>
								<HBox alignItems="Center" wrap="Wrap">
									<Text text="{i18n>lblBehavior}" width="100px" />
									<CheckBox
										text="{i18n>cbShowIcon}"
										selected="{json>/showIcon}"
										select=".onShowIconSelect" />
									<CheckBox
										text="{i18n>cbShowText}"
										selected="{json>/showText}"
										select=".onShowTextSelect" />
									<CheckBox
										text="{i18n>cbIconFirst}"
										selected="{json>/iconFirst}" />
									<CheckBox
										text="{i18n>cbEnabled}"
										selected="{json>/enabled}" />
								</HBox>
							</VBox>
						</f:content>
					</f:Card>

					<!-- card 2: the library control -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/fullName}"
								subtitle="{i18n>cardTouch}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<!-- one button, the type comes from the option beside it:
								     the two columns are there to be compared, and a list
								     of every type on both sides makes that harder, not
								     easier -->
								<VBox alignItems="Start">
									<tc:Button
										text="{json>/text}"
										type="{json>/type}"
										icon="{json>/icon}"
										iconFirst="{json>/iconFirst}"
										enabled="{json>/enabled}"
										size="{json>/size}" />
								</VBox>
							</VBox>
						</f:content>
					</f:Card>

					<!-- card 3: the sap.m original -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/replaces}"
								subtitle="{i18n>cardOriginal}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<VBox alignItems="Start">
									<Button
										text="{json>/text}"
										type="{json>/type}"
										icon="{json>/icon}"
										iconFirst="{json>/iconFirst}"
										enabled="{json>/enabled}" />
								</VBox>
							</VBox>
						</f:content>
					</f:Card>
				</HBox>

				<core:Fragment
					fragmentName="ui5.touch.controls.demo.view.ExampleCard"
					type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
