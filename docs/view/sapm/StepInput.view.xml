<mvc:View
	controllerName="ui5.touch.controls.demo.controller.sapm.StepInput"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:control="ui5.touch.controls.demo.control"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls"
	core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	height="100%">
	<f:DynamicPage
		headerExpanded="true"
		class="touchControlsPage">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{control>/fullName}" wrapping="true" />
				</f:heading>
				<f:expandedContent>
					<Text text="{i18n>docStepInputSummary}" />
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{i18n>docStepInputSummary}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<HBox wrap="Wrap">
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsFact sapUiMediumMarginEnd">
						<Text
							text="{= ${i18n>introExtends} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="{= !!${control>/extendsUrl} }">
							<Link
								text="{control>/extendsClass}"
								href="{control>/extendsUrl}"
								target="_blank"
								enabled="{= !!${control>/extendsUrl} }" />
						</control:LinkList>
					</HBox>
					<HBox
						alignItems="Center"
						wrap="Wrap"
						visible="{control>/showOriginal}"
						class="touchControlsFact sapUiMediumMarginEnd">
						<Text
							text="{= ${i18n>introOriginalLabel} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="{= !!${control>/docUrl} }">
							<Link
								text="{control>/replaces}"
								href="{control>/docUrl}"
								target="_blank"
								enabled="{= !!${control>/docUrl} }" />
						</control:LinkList>
					</HBox>
					<ObjectAttribute
						title="{i18n>introSince}"
						text="{control>/since}"
						class="sapUiMediumMarginEnd" />
					<ObjectAttribute
						title="{i18n>introVisibility}"
						text="{control>/visibility}"
						class="sapUiMediumMarginEnd" />
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsFact">
						<Text
							text="{= ${i18n>introSource} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="true" links="{control>/sources}">
							<Link
								text="{control>file}"
								href="{control>url}"
								target="_blank" />
						</control:LinkList>
					</HBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox width="100%">
				<Text text="{i18n>docStepInputDescription}" />
				<Text
					text="{
						parts: ['i18n>overviewReplaces', 'control>/replaces', 'control>/original'],
						formatter: 'formatMessage'
					}"
					class="sapUiSmallMarginTop" />
				<Text
					text="{i18n>introSizeNote}"
					class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
				<HBox
					width="100%"
					wrap="Wrap"
					class="touchControlsCardRow touchControlsPlaygroundRow">
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header title="{i18n>optionsTitle}" />
						</f:header>
						<f:content>
							<VBox
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<core:Fragment
									fragmentName="ui5.touch.controls.demo.view.SizeOption"
									type="XML" />
								<HBox alignItems="Center">
									<Text text="{i18n>lblMin}" width="100px" />
									<Input
										value="{json>/min}"
										type="Number"
										valueLiveUpdate="true"
										width="100px" />
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblMax}" width="100px" />
									<Input
										value="{json>/max}"
										type="Number"
										valueLiveUpdate="true"
										width="100px" />
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblButtonType}" width="100px" />
									<Select selectedKey="{json>/buttonType}">
										<core:Item key="Default" text="Default" />
										<core:Item key="Emphasized" text="Emphasized" />
										<core:Item key="Accept" text="Accept" />
										<core:Item key="Reject" text="Reject" />
										<core:Item key="Attention" text="Attention" />
										<core:Item key="Transparent" text="Transparent" />
										<core:Item key="Neutral" text="Neutral" />
										<core:Item key="Critical" text="Critical" />
										<core:Item key="Negative" text="Negative" />
										<core:Item key="Success" text="Success" />
										<core:Item key="Ghost" text="Ghost" />
									</Select>
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblBehavior}" width="100px" />
									<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
									<CheckBox text="{i18n>cbEditable}" selected="{json>/editable}" />
								</HBox>
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/fullName}"
								subtitle="{i18n>cardTouch}" />
						</f:header>
						<f:content>
							<VBox
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<tc:StepInput
									value="{json>/value}"
									min="{json>/min}"
									max="{json>/max}"
									size="{json>/size}"
									buttonType="{json>/buttonType}"
									enabled="{json>/enabled}"
									editable="{json>/editable}"
									change=".onChange" />
							</VBox>
						</f:content>
					</f:Card>
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/replaces}"
								subtitle="{i18n>cardOriginal}" />
						</f:header>
						<f:content>
							<VBox
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<StepInput
									value="{json>/value}"
									min="{json>/min}"
									max="{json>/max}"
									enabled="{json>/enabled}"
									editable="{json>/editable}"
									width="10rem" />
							</VBox>
						</f:content>
					</f:Card>
				</HBox>
				<core:Fragment
					fragmentName="ui5.touch.controls.demo.view.ExampleCard"
					type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
