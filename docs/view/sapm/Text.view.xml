<mvc:View
	controllerName="ui5.touch.controls.demo.controller.sapm.Text"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:control="ui5.touch.controls.demo.control"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls"
	core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	height="100%">
	<f:DynamicPage
		headerExpanded="true"
		class="touchControlsPage">
		<!-- the head of the page reads like an entry of the demo kit: the name
		     of the class, one or two sentences on what it is, and beside them
		     the facts about the class -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{control>/fullName}" wrapping="true" />
				</f:heading>
				<f:expandedContent>
					<Text text="{control>/summary}" />
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{control>/summary}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<!-- the facts about the class, the way the demo kit lists them -->
				<HBox wrap="Wrap">
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsFact sapUiMediumMarginEnd">
						<Text
							text="{= ${i18n>introExtends} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="{= !!${control>/extendsUrl} }">
							<Link
								text="{control>/extendsClass}"
								href="{control>/extendsUrl}"
								target="_blank"
								enabled="{= !!${control>/extendsUrl} }" />
						</control:LinkList>
					</HBox>
					<HBox
						alignItems="Center"
						wrap="Wrap"
						visible="{control>/showOriginal}"
						class="touchControlsFact sapUiMediumMarginEnd">
						<Text
							text="{= ${i18n>introOriginalLabel} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="{= !!${control>/docUrl} }">
							<Link
								text="{control>/replaces}"
								href="{control>/docUrl}"
								target="_blank"
								enabled="{= !!${control>/docUrl} }" />
						</control:LinkList>
					</HBox>
					<ObjectAttribute
						title="{i18n>introSince}"
						text="{control>/since}"
						class="sapUiMediumMarginEnd" />
					<ObjectAttribute
						title="{i18n>introVisibility}"
						text="{control>/visibility}"
						class="sapUiMediumMarginEnd" />
					<!-- A class is written in more than one file - what it does and what
					     it looks like - so this fact carries a link per file, written as
					     an enumeration. -->
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsFact">
						<Text
							text="{= ${i18n>introSource} + ':' }"
							class="touchControlsFactTitle" />
						<control:LinkList external="true" links="{control>/sources}">
							<Link
								text="{control>file}"
								href="{control>url}"
								target="_blank" />
						</control:LinkList>
					</HBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
			<VBox width="100%">
				<!-- overview: the class in running text, longer than the summary
				     in the head of the page -->
				<Text text="{control>/description}" />
				<Text
					text="{
						parts: ['i18n>overviewReplaces', 'control>/replaces', 'control>/original'],
						formatter: 'formatMessage'
					}"
					class="sapUiSmallMarginTop" />
				<Text
					text="{i18n>introSizeNote}"
					class="sapUiSmallMarginTop sapUiSmallMarginBottom" />

				<!-- playground: three cards - what can be set, the control of
				     this library, and the sap.m original beside it -->
				<HBox
					width="100%"
					wrap="Wrap"
					class="touchControlsCardRow touchControlsPlaygroundRow">
					<!-- card 1: what can be set -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header title="{i18n>optionsTitle}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
								<HBox alignItems="Center">
									<Text text="{i18n>lblText}" width="100px" />
									<Input
										value="{json>/text}"
										placeholder="{i18n>lblText}"
										valueLiveUpdate="true"
										width="300px" />
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblColor}" width="100px" />
									<Input
										value="{json>/color}"
										placeholder="{i18n>phColor}"
										valueLiveUpdate="true"
										width="200px" />
									<Button
										icon="sap-icon://color-fill"
										tooltip="{i18n>tooltipChooseColor}"
										press=".onColorPress"
										class="sapUiTinyMarginBegin" />
								</HBox>
							</VBox>
						</f:content>
					</f:Card>

					<!-- card 2: the library control -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/fullName}"
								subtitle="{i18n>cardTouch}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<tc:Text
									text="{json>/text}"
									color="{json>/color}"
									size="{json>/size}"
									press=".onTextPress" />
							</VBox>
						</f:content>
					</f:Card>

					<!-- card 3: the sap.m original -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/replaces}"
								subtitle="{i18n>cardOriginal}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<Text text="{json>/text}" />
							</VBox>
						</f:content>
					</f:Card>
				</HBox>

				<core:Fragment
					fragmentName="ui5.touch.controls.demo.view.ExampleCard"
					type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
