<mvc:View
	controllerName="ui5.touch.controls.demo.controller.sapm.Select"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:control="ui5.touch.controls.demo.control"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls"
	core:require="{ formatMessage: 'sap/base/strings/formatMessage' }"
	height="100%">
	<f:DynamicPage
		headerExpanded="true"
		class="touchControlsPage">
		<!-- the head of the page reads like an entry of the demo kit: the name
		     of the class, one or two sentences on what it is, and beside them
		     the facts about the class -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{control>/fullName}" wrapping="true" />
				</f:heading>
				<f:expandedContent>
					<Text text="{control>/summary}" />
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{control>/summary}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>

		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<!-- the facts about the class, the way the demo kit lists them -->
				<HBox wrap="Wrap">
					<ObjectAttribute title="{i18n>introExtends}" class="sapUiMediumMarginEnd">
						<customContent>
							<Link
								text="{control>/extendsClass}"
								href="{control>/extendsUrl}"
								target="_blank"
								enabled="{= !!${control>/extendsUrl} }" />
						</customContent>
					</ObjectAttribute>
					<ObjectAttribute
						title="{i18n>introOriginalLabel}"
						class="sapUiMediumMarginEnd"
						visible="{control>/showOriginal}">
						<customContent>
							<Link
								text="{control>/replaces}"
								href="{control>/docUrl}"
								target="_blank"
								enabled="{= !!${control>/docUrl} }" />
						</customContent>
					</ObjectAttribute>
					<ObjectAttribute
						title="{i18n>introSince}"
						text="{control>/since}"
						class="sapUiMediumMarginEnd" />
					<ObjectAttribute
						title="{i18n>introVisibility}"
						text="{control>/visibility}"
						class="sapUiMediumMarginEnd" />
					<!-- A class is written in more than one file - what it does and what
					     it looks like - so the fact carries a link per file. The row is
					     a control of its own: it writes the links as an enumeration and
					     marks them as leading out of the page.

					     The name of the fact is written beside it rather than taken from
					     an ObjectAttribute like the facts before it: that one holds a
					     single sap.m.Link and rejects anything else at runtime. It takes
					     the colour of a label, which is the colour an attribute title
					     takes too. -->
					<HBox
						alignItems="Center"
						wrap="Wrap"
						class="touchControlsSource">
						<Text
							text="{= ${i18n>introSource} + ':' }"
							class="touchControlsSourceTitle" />
						<control:LinkList external="true" links="{control>/sources}">
							<Link
								text="{control>file}"
								href="{control>url}"
								target="_blank" />
						</control:LinkList>
					</HBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>

		<f:content>
			<VBox width="100%">
				<!-- overview: the class in running text, longer than the summary
				     in the head of the page -->
				<Text text="{control>/description}" />
				<Text
					text="{
						parts: ['i18n>overviewReplaces', 'control>/replaces', 'control>/original'],
						formatter: 'formatMessage'
					}"
					class="sapUiSmallMarginTop" />
				<Text
					text="{i18n>introSizeNote}"
					class="sapUiSmallMarginTop sapUiSmallMarginBottom" />

				<!-- playground: three cards - what can be set, the control of
				     this library, and the sap.m original beside it -->
				<HBox
					width="100%"
					wrap="Wrap"
					class="touchControlsCardRow touchControlsPlaygroundRow">
					<!-- card 1: what can be set -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header title="{i18n>optionsTitle}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
								<core:Fragment fragmentName="ui5.touch.controls.demo.view.ValueStateOption" type="XML" />
								<HBox alignItems="Center">
									<Text text="{i18n>lblBehavior}" width="100px" />
									<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
									<CheckBox text="{i18n>cbEditable}" selected="{json>/editable}" />
								</HBox>
								<HBox alignItems="Center">
									<Text text="{i18n>lblSelectedKey}" width="100px" />
									<Text text="{json>/selectedKey}" />
								</HBox>
								<core:Fragment fragmentName="ui5.touch.controls.demo.view.LastEventOption" type="XML" />
							</VBox>
						</f:content>
					</f:Card>

					<!-- card 2: the library control -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/fullName}"
								subtitle="{i18n>cardTouch}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<tc:Select
									selectedKey="{json>/selectedKey}"
									size="{json>/size}"
									enabled="{json>/enabled}"
									editable="{json>/editable}"
									valueState="{json>/valueState}"
									width="20rem"
									items="{json>/workstations}"
									change=".onChange">
									<core:Item key="{json>key}" text="{json>text}" />
								</tc:Select>
							</VBox>
						</f:content>
					</f:Card>

					<!-- card 3: the sap.m original -->
					<f:Card class="sapUiMediumMarginBottom">
						<f:layoutData>
							<FlexItemData growFactor="1" baseSize="0" />
						</f:layoutData>
						<f:header>
							<cards:Header
								title="{control>/replaces}"
								subtitle="{i18n>cardOriginal}" />
						</f:header>
						<f:content>
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
								<Select
									selectedKey="{json>/selectedKey}"
									enabled="{json>/enabled}"
									editable="{json>/editable}"
									valueState="{json>/valueState}"
									width="20rem"
									items="{json>/workstations}">
									<core:Item key="{json>key}" text="{json>text}" />
								</Select>
							</VBox>
						</f:content>
					</f:Card>
				</HBox>

				<core:Fragment
					fragmentName="ui5.touch.controls.demo.view.ExampleCard"
					type="XML" />
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
