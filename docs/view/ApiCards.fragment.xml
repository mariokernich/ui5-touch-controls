<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards">
	<!-- The API of the control, a card per kind: what it is set with, what it
	     fires and what goes inside it. A control has all three only rarely, so
	     a card is there only where the "api" model carries entries for it -
	     see BaseController.setApi.

	     The note about the base class hangs under the properties: that is the
	     card every one of these controls has, and what it says covers the
	     events as well. -->
	<VBox width="100%">
		<!-- properties -->
		<f:Card
			class="sapUiMediumMarginBottom"
			visible="{= ${api>/hasProperties} }">
			<f:header>
				<cards:Header
					title="{i18n>apiProperties}"
					subtitle="{i18n>apiPropertiesSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<Table items="{api>/properties}">
						<columns>
							<Column width="11rem">
								<Label text="{i18n>colProperty}" />
							</Column>
							<Column
								width="15rem"
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colType}" />
							</Column>
							<Column
								width="8rem"
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colDefault}" />
							</Column>
							<Column
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colDescription}" />
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<Text text="{api>name}" />
								<Text text="{api>type}" />
								<Text text="{api>default}" />
								<Text text="{api>text}" />
							</ColumnListItem>
						</items>
					</Table>
					<!-- the rest of the API, where it belongs to a class of
					     this library that has a page of its own -->
					<HBox
						alignItems="Center"
						wrap="Wrap"
						visible="{= !!${api>/inherits} }"
						class="sapUiSmallMarginTop">
						<Text
							text="{i18n>apiInherited}"
							class="sapUiTinyMarginEnd" />
						<Link
							text="{api>/inherits}"
							press=".onNavToExtends" />
					</HBox>
				</VBox>
			</f:content>
		</f:Card>
		<!-- events -->
		<f:Card
			class="sapUiMediumMarginBottom"
			visible="{= ${api>/hasEvents} }">
			<f:header>
				<cards:Header
					title="{i18n>apiEvents}"
					subtitle="{i18n>apiEventsSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<Table items="{api>/events}">
						<columns>
							<Column width="11rem">
								<Label text="{i18n>colEvent}" />
							</Column>
							<Column
								width="11rem"
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colParameters}" />
							</Column>
							<Column
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colDescription}" />
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<Text text="{api>name}" />
								<Text text="{api>parameters}" />
								<Text text="{api>text}" />
							</ColumnListItem>
						</items>
					</Table>
				</VBox>
			</f:content>
		</f:Card>
		<!-- aggregations -->
		<f:Card
			class="sapUiMediumMarginBottom"
			visible="{= ${api>/hasAggregations} }">
			<f:header>
				<cards:Header
					title="{i18n>apiAggregations}"
					subtitle="{i18n>apiAggregationsSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<Table items="{api>/aggregations}">
						<columns>
							<Column width="11rem">
								<Label text="{i18n>colAggregation}" />
							</Column>
							<Column
								width="15rem"
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colType}" />
							</Column>
							<Column
								width="8rem"
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colCardinality}" />
							</Column>
							<Column
								demandPopin="true"
								minScreenWidth="Tablet"
								popinDisplay="Inline">
								<Label text="{i18n>colDescription}" />
							</Column>
						</columns>
						<items>
							<ColumnListItem>
								<Text text="{api>name}" />
								<Text text="{api>type}" />
								<Text text="{api>cardinality}" />
								<Text text="{api>text}" />
							</ColumnListItem>
						</items>
					</Table>
				</VBox>
			</f:content>
		</f:Card>
	</VBox>
</core:FragmentDefinition>
