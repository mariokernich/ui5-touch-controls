<mvc:View
	controllerName="ui5.touch.controls.demo.controller.App"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:tnt="sap.tnt"
	displayBlock="true"
	height="100%">
	<tnt:ToolPage id="toolPage" sideExpanded="{app>/sideExpanded}">
		<tnt:header>
			<tnt:ToolHeader>
				<Button
					icon="sap-icon://menu2"
					type="Transparent"
					tooltip="{i18n>toggleNavigation}"
					press=".onMenuPress" />
				<!-- only the icon tile of the logo, the name is the title next to
				     it - the full logo with its wordmark would be too wide here -->
				<Image
					src="{app>/logoMark}"
					height="2rem"
					alt="{i18n>appTitle}"
					tooltip="{i18n>home}"
					densityAware="false"
					press=".onLogoPress"
					class="touchControlsHeaderLogo" />
				<Title
					text="{i18n>appTitle}"
					level="H1"
					class="touchControlsHeaderTitle" />
				<Text
					text="{app>/version}"
					tooltip="{i18n>versionTooltip}"
					class="touchControlsHeaderVersion sapUiTinyMarginEnd" />
				<!-- a spacer on either side is what puts the search in the middle:
				     the two of them share whatever the groups beside them leave
				     over, so the field sits between them -->
				<ToolbarSpacer />
				<SearchField
					width="22rem"
					placeholder="{i18n>searchPlaceholder}"
					tooltip="{i18n>searchTooltip}"
					enableSuggestions="true"
					suggest=".onSearchSuggest"
					search=".onSearch"
					suggestionItems="{app>/searchSuggestions}">
					<SuggestionItem
						key="{app>key}"
						text="{app>text}"
						description="{app>description}"
						icon="{app>icon}" />
				</SearchField>
				<ToolbarSpacer />
				<!-- the languages are named in their own language, so the entries
				     read the same whichever one is active -->
				<ComboBox
					tooltip="{i18n>language}"
					selectedKey="{app>/language}"
                    width="150px"
                    showSecondaryValues="true"
					change=".onLanguageChange">
					<core:ListItem key="en" text="English" additionalText="EN" />
					<core:ListItem key="de" text="Deutsch" additionalText="DE" />
					<core:ListItem key="es" text="Español" additionalText="ES" />
					<core:ListItem key="fr" text="Français" additionalText="FR" />
					<core:ListItem key="hi" text="हिन्दी" additionalText="HI" />
					<core:ListItem key="it" text="Italiano" additionalText="IT" />
					<core:ListItem key="ja" text="日本語" additionalText="JA" />
					<core:ListItem key="nl" text="Nederlands" additionalText="NL" />
					<core:ListItem key="pl" text="Polski" additionalText="PL" />
					<core:ListItem key="pt" text="Português" additionalText="PT" />
					<core:ListItem key="ru" text="Русский" additionalText="RU" />
					<core:ListItem key="tr" text="Türkçe" additionalText="TR" />
					<core:ListItem key="uk" text="Українська" additionalText="UK" />
					<core:ListItem key="zh" text="中文" additionalText="ZH" />
				</ComboBox>
				<Select
					tooltip="{i18n>theme}"
					selectedKey="{app>/theme}"
                    width="150px"
					change=".onThemeChange">
					<core:Item key="sap_horizon" text="Horizon" />
					<core:Item key="sap_horizon_dark" text="Horizon Dark" />
					<core:Item key="sap_horizon_hcb" text="Horizon HCB" />
					<core:Item key="sap_horizon_hcw" text="Horizon HCW" />
					<core:Item key="sap_fiori_3" text="Fiori 3" />
					<core:Item key="sap_fiori_3_dark" text="Fiori 3 Dark" />
				</Select>
				<Button
					icon="sap-icon://navigation-left-arrow"
					type="Transparent"
					enabled="{= !!${app>/previousKey} }"
					tooltip="{= ${app>/previousKey} ? ${i18n>previous} + ': ' + ${app>/previousText} : '' }"
					press=".onPreviousPress" />
				<Button
					icon="sap-icon://navigation-right-arrow"
					type="Transparent"
					enabled="{= !!${app>/nextKey} }"
					tooltip="{= ${app>/nextKey} ? ${i18n>next} + ': ' + ${app>/nextText} : '' }"
					press=".onNextPress" />
				<!-- the mark is drawn by the stylesheet, so the link carries no
				     text of its own; the tooltip is what names it -->
				<Link
					tooltip="{i18n>githubTooltip}"
					href="https://github.com/mariokernich/ui5-touch-controls"
					target="_blank"
					class="touchControlsHeaderGithub" />
			</tnt:ToolHeader>
		</tnt:header>
		<tnt:sideContent>
			<tnt:SideNavigation
				id="sideNavigation"
				selectedKey="{app>/currentKey}"
				itemSelect=".onNavigationSelect">
				<tnt:NavigationList>
					<tnt:NavigationListItem
						key="GettingStarted"
						text="{i18n>navGettingStarted}"
						icon="sap-icon://home" />
					<tnt:NavigationListItem
						key="Setup"
						text="{i18n>navSetup}"
						icon="sap-icon://wrench" />
					<tnt:NavigationListItem
						key="Documentation"
						text="{i18n>navDocumentation}"
						icon="sap-icon://documents" />
					<!-- the changelog is English only, so its name is not translated
					     either -->
					<tnt:NavigationListItem
						key="Changelog"
						text="Changelog"
						icon="sap-icon://history" />
					<!-- A NavigationListGroup is used instead of nested
					     NavigationListItems on purpose: sap.tnt does not render icons
					     on second-level items by design, whereas the items of a group
					     stay on the first level and keep their icons. -->
					<tnt:NavigationListGroup
						text="{i18n>groupPorted}"
						expanded="true"
						items="{pages>/ported}">
						<tnt:NavigationListItem
							key="{pages>key}"
							text="{pages>text}"
							icon="{pages>icon}" />
					</tnt:NavigationListGroup>
					<tnt:NavigationListGroup
						text="{i18n>groupAdditional}"
						expanded="true"
						items="{pages>/additional}">
						<tnt:NavigationListItem
							key="{pages>key}"
							text="{pages>text}"
							icon="{pages>icon}" />
					</tnt:NavigationListGroup>
					<!-- what is used from a controller rather than put in a view -->
					<tnt:NavigationListGroup
						text="{i18n>groupClasses}"
						expanded="true"
						items="{pages>/classes}">
						<tnt:NavigationListItem
							key="{pages>key}"
							text="{pages>text}"
							icon="{pages>icon}" />
					</tnt:NavigationListGroup>
				</tnt:NavigationList>
			</tnt:SideNavigation>
		</tnt:sideContent>
		<tnt:mainContents>
			<!-- ToolPage has no footer aggregation, so the footer goes into the
			     main contents beside the pages: the NavContainer takes the room
			     that is left, the footer keeps its own height. -->
			<VBox height="100%" class="touchControlsMain">
				<NavContainer id="pages" height="100%" autoFocus="false">
					<layoutData>
						<!-- the class is on the layout data because that is where the
						     box puts it: on the element it wraps the page area in. The
						     stylesheet needs it to rank the pages above the footer. -->
						<FlexItemData
							growFactor="1"
							shrinkFactor="1"
							baseSize="0"
							styleClass="touchControlsPages" />
					</layoutData>
				</NavContainer>
				<core:Fragment
					fragmentName="ui5.touch.controls.demo.view.Footer"
					type="XML" />
			</VBox>
		</tnt:mainContents>
	</tnt:ToolPage>
</mvc:View>
