<mvc:View
	controllerName="ui5.touch.controls.demo.controller.TextArea"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ControlIntro"
			type="XML" />

		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="{i18n>optionsTextArea}" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblPlaceholder}" width="100px" />
							<Input
								value="{json>/placeholder}"
								placeholder="{i18n>lblPlaceholder}"
								valueLiveUpdate="true"
								width="300px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblRows}" width="100px" />
							<StepInput value="{json>/rows}" min="1" max="20" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblMaxLength}" width="100px" />
							<StepInput value="{json>/maxLength}" min="0" max="500" step="10" />
						</HBox>
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.ValueStateOption" type="XML" />
						<HBox alignItems="Center" wrap="Wrap">
							<Text text="{i18n>lblBehavior}" width="100px" />
							<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
							<CheckBox text="{i18n>cbEditable}" selected="{json>/editable}" />
							<CheckBox
								text="{i18n>cbVirtualKeyboard}"
								selected="{json>/showVirtualKeyboard}" />
							<CheckBox
								text="{i18n>cbDocked}"
								selected="{json>/keyboardDocked}"
								enabled="{json>/showVirtualKeyboard}" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblMode}" width="100px" />
							<Select
								selectedKey="{json>/keyboardMode}"
								enabled="{json>/showVirtualKeyboard}">
								<core:Item key="QWERTY" text="QWERTY" />
								<core:Item key="QWERTZ" text="QWERTZ" />
								<core:Item key="AZERTY" text="AZERTY" />
								<core:Item key="Spanish" text="Spanish" />
								<core:Item key="Ukrainian" text="Ukrainian" />
								<core:Item key="Russian" text="Russian" />
								<core:Item key="Hindi" text="Hindi" />
								<core:Item key="QWERTYMobile" text="QWERTYMobile" />
								<core:Item key="QWERTZMobile" text="QWERTZMobile" />
								<core:Item key="Numeric" text="Numeric" />
								<core:Item key="Decimal" text="Decimal" />
								<core:Item key="Email" text="Email" />
								<core:Item key="Phone" text="Phone" />
								<core:Item key="Calculator" text="Calculator" />
							</Select>
						</HBox>
						<Text text="{i18n>textAreaKeyboardHint}" class="sapUiTinyMarginTop" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="ui5.touch.controls.TextArea"
						subtitle="{i18n>cardTouch}" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<tc:TextArea
							value="{json>/value}"
							placeholder="{json>/placeholder}"
							rows="{json>/rows}"
							maxLength="{json>/maxLength}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							showVirtualKeyboard="{json>/showVirtualKeyboard}"
							width="100%"
							liveChange=".onLiveChange">
							<tc:virtualKeyboard>
								<tc:VirtualKeyboard
									size="{json>/size}"
									mode="{json>/keyboardMode}"
									docked="{json>/keyboardDocked}" />
							</tc:virtualKeyboard>
						</tc:TextArea>
					</VBox>
				</f:content>
			</f:Card>

			<!-- the sap.m original -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="sap.m.TextArea"
						subtitle="{i18n>cardOriginal}" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<TextArea
							value="{json>/value}"
							placeholder="{json>/placeholder}"
							rows="{json>/rows}"
							maxLength="{json>/maxLength}"
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							valueLiveUpdate="true"
							width="100%" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
