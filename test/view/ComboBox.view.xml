<mvc:View
	controllerName="ui5.touch.controls.demo.controller.ComboBox"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="ComboBox Options" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.ValueStateOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="Behavior" width="100px" />
							<CheckBox text="Enabled" selected="{json>/enabled}" />
							<CheckBox text="Editable" selected="{json>/editable}" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="Value" width="100px" />
							<Text text="{json>/value}" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="Selected key" width="100px" />
							<Text text="{json>/selectedKey}" />
						</HBox>
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.LastEventOption" type="XML" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="ui5.touch.controls.ComboBox" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<tc:ComboBox
							value="{json>/value}"
							selectedKey="{json>/selectedKey}"
							placeholder="Search material..."
							size="{json>/size}"
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							width="22rem"
							items="{json>/materials}"
							change=".onChange">
							<core:Item key="{json>key}" text="{json>text}" />
						</tc:ComboBox>
					</VBox>
				</f:content>
			</f:Card>

			<!-- the sap.m original -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="sap.m.ComboBox" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<ComboBox
							value="{json>/value}"
							selectedKey="{json>/selectedKey}"
							placeholder="Search material..."
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							width="22rem"
							items="{json>/materials}">
							<core:Item key="{json>key}" text="{json>text}" />
						</ComboBox>
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
