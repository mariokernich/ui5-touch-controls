<mvc:View
	controllerName="ui5.touch.controls.demo.controller.Switch"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="{i18n>optionsSwitch}" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblType}" width="100px" />
							<Select selectedKey="{json>/type}">
								<core:Item key="Default" text="Default" />
								<core:Item key="AcceptReject" text="AcceptReject" />
							</Select>
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblTextOn}" width="100px" />
							<Input
								value="{json>/customTextOn}"
								placeholder="ON"
								valueLiveUpdate="true"
								width="150px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblTextOff}" width="100px" />
							<Input
								value="{json>/customTextOff}"
								placeholder="OFF"
								valueLiveUpdate="true"
								width="150px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblBehavior}" width="100px" />
							<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
							<CheckBox text="{i18n>cbState}" selected="{json>/state}" />
						</HBox>
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.LastEventOption" type="XML" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="ui5.touch.controls.Switch" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<tc:Switch
							state="{json>/state}"
							customTextOn="{json>/customTextOn}"
							customTextOff="{json>/customTextOff}"
							type="{json>/type}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							change=".onChange" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the sap.m original -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="sap.m.Switch" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Switch
							state="{json>/state}"
							customTextOn="{json>/customTextOn}"
							customTextOff="{json>/customTextOff}"
							type="{json>/type}"
							enabled="{json>/enabled}" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
