<mvc:View
	controllerName="ui5.touch.controls.demo.controller.BarcodeInput"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="BarcodeInput Options" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment
							fragmentName="ui5.touch.controls.demo.view.SizeOption"
							type="XML" />
						<HBox alignItems="Center">
							<Text text="Scan timeout" width="120px" />
							<StepInput value="{json>/scanTimeout}" min="5" max="500" step="5" />
							<Text text="ms" class="sapUiTinyMarginBegin" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="Min length" width="120px" />
							<StepInput value="{json>/minLength}" min="1" max="30" />
						</HBox>
						<core:Fragment
							fragmentName="ui5.touch.controls.demo.view.ValueStateOption"
							type="XML" />
						<HBox alignItems="Center" wrap="Wrap">
							<Text text="Behavior" width="120px" />
							<CheckBox text="Enabled" selected="{json>/enabled}" />
							<CheckBox text="Editable" selected="{json>/editable}" />
							<CheckBox text="Clear on scan" selected="{json>/clearOnScan}" />
						</HBox>
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header
						title="ui5.touch.controls.BarcodeInput"
						subtitle="Scan a code, or type one and press Enter" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<tc:BarcodeInput
							value="{json>/value}"
							placeholder="Scan or type a code..."
							scanTimeout="{json>/scanTimeout}"
							minLength="{json>/minLength}"
							clearOnScan="{json>/clearOnScan}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							width="100%"
							scan=".onScan"
							change=".onChange" />
						<FormattedText
							htmlText="{i18n>barcodeHint}"
							width="100%"
							class="sapUiTinyMarginTop" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- what the control has fired -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="Events" subtitle="The most recent one first" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Table items="{json>/log}">
							<columns>
								<Column width="7rem">
									<Label text="Event" />
								</Column>
								<Column>
									<Label text="Value" />
								</Column>
								<Column width="8rem">
									<Label text="Time" />
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<Text text="{json>kind}" />
									<Text text="{json>value}" />
									<Text text="{json>time}" />
								</ColumnListItem>
							</items>
						</Table>
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />

	</Page>
</mvc:View>
