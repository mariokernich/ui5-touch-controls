<mvc:View
	controllerName="ui5.touch.controls.demo.controller.OverflowToolbar"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:editor="sap.ui.codeeditor"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<HBox alignItems="Center" class="sapUiTinyMarginBottom">
			<Text text="{i18n>lblButtonSize}" width="100px" />
			<Select selectedKey="{json>/size}">
				<core:Item key="S" text="S" />
				<core:Item key="M" text="M" />
				<core:Item key="L" text="L" />
				<core:Item key="XL" text="XL" />
				<core:Item key="2XL" text="2XL" />
				<core:Item key="3XL" text="3XL" />
				<core:Item key="4XL" text="4XL" />
				<core:Item key="5XL" text="5XL" />
				<core:Item key="6XL" text="6XL" />
			</Select>
		</HBox>
		<HBox alignItems="Center" class="sapUiSmallMarginBottom">
			<Text text="{i18n>lblToolbarWidth}" width="100px" />
			<Slider
				min="20"
				max="100"
				value="100"
				width="20rem"
				liveChange=".onWidthChange" />
		</HBox>

		<!-- both toolbars live in a container whose width follows the slider,
		     so the overflow behaviour can be compared directly -->
		<VBox width="{json>/containerWidth}">
			<Title text="{i18n>otWithoutPriorities}" class="sapUiMediumMarginTop sapUiTinyMarginBottom" />
			<tc:OverflowToolbar size="{json>/size}">
				<tc:Button
					text="{i18n>btnNew}"
					icon="sap-icon://add"
					type="Emphasized"
					size="{json>/size}"
					press=".onDemoPress" />
				<tc:Button
					text="{i18n>btnEdit}"
					icon="sap-icon://edit"
					size="{json>/size}"
					press=".onDemoPress" />
				<tc:Button
					text="{i18n>btnCopy}"
					icon="sap-icon://copy"
					size="{json>/size}"
					press=".onDemoPress" />
				<tc:Button
					text="{i18n>btnShare}"
					icon="sap-icon://share"
					size="{json>/size}"
					press=".onDemoPress" />
				<ToolbarSpacer />
				<tc:Button
					text="{i18n>btnDelete}"
					icon="sap-icon://delete"
					type="Reject"
					size="{json>/size}"
					press=".onDemoPress" />
			</tc:OverflowToolbar>
			<Text text="{i18n>overflowPlainHint}" class="sapUiTinyMarginTop" />

			<Title
				text="{i18n>otWithPriorities}"
				class="sapUiMediumMarginTop sapUiTinyMarginBottom" />
			<tc:OverflowToolbar size="{json>/size}">
				<tc:Button
					text="{i18n>btnPrintLow}"
					icon="sap-icon://print"
					size="{json>/size}"
					press=".onDemoPress">
					<tc:layoutData>
						<OverflowToolbarLayoutData priority="Low" />
					</tc:layoutData>
				</tc:Button>
				<tc:Button
					text="{i18n>btnExport}"
					icon="sap-icon://excel-attachment"
					size="{json>/size}"
					press=".onDemoPress" />
				<tc:Button
					text="{i18n>btnSaveNever}"
					icon="sap-icon://save"
					type="Emphasized"
					size="{json>/size}"
					press=".onDemoPress">
					<tc:layoutData>
						<OverflowToolbarLayoutData priority="NeverOverflow" />
					</tc:layoutData>
				</tc:Button>
				<ToolbarSpacer />
				<tc:Button
					text="{i18n>btnAboutAlways}"
					icon="sap-icon://hint"
					type="Ghost"
					size="{json>/size}"
					press=".onDemoPress">
					<tc:layoutData>
						<OverflowToolbarLayoutData priority="AlwaysOverflow" />
					</tc:layoutData>
				</tc:Button>
			</tc:OverflowToolbar>
			<Text text="{i18n>overflowPriorityHint}" class="sapUiTinyMarginTop" />
		</VBox>

		<Title text="{i18n>otAsFooter}" class="sapUiMediumMarginTop sapUiTinyMarginBottom" />
		<!-- the page needs an explicit height, otherwise it collapses -->
		<Page
			title="{i18n>otFooterPageTitle}"
			showFooter="true"
			class="touchControlsDemoPage">
			<footer>
				<tc:OverflowToolbar size="{json>/size}">
					<tc:Button
						text="{i18n>btnSave}"
						icon="sap-icon://save"
						type="Emphasized"
						size="{json>/size}"
						press=".onDemoPress" />
					<tc:Button
						text="{i18n>btnCancel}"
						icon="sap-icon://decline"
						size="{json>/size}"
						press=".onDemoPress" />
					<ToolbarSpacer />
					<tc:Button
						text="{i18n>btnApprove}"
						icon="sap-icon://accept"
						type="Accept"
						size="{json>/size}"
						press=".onDemoPress" />
					<tc:Button
						text="{i18n>btnReject}"
						icon="sap-icon://decline"
						type="Reject"
						size="{json>/size}"
						press=".onDemoPress" />
					<tc:Button
						text="{i18n>btnHistory}"
						icon="sap-icon://history"
						size="{json>/size}"
						press=".onDemoPress" />
				</tc:OverflowToolbar>
			</footer>
		</Page>
		<Text text="{i18n>overflowFooterHint}" class="sapUiTinyMarginTop" />

		<Title
			text="{i18n>otAsDialogFooter}"
			class="sapUiMediumMarginTop sapUiTinyMarginBottom" />
		<Text text="{i18n>overflowDialogHint}" />
		<HBox class="touchControlsButtonRow sapUiSmallMarginTop">
			<tc:Button
				text="{i18n>btnOpenDialog}"
				icon="sap-icon://popup-window"
				type="Emphasized"
				size="{json>/size}"
				press=".onOpenDialog" />
		</HBox>
		<VBox width="100%" items="{example>/dialog}" class="sapUiSmallMarginTop">
			<f:Card>
				<f:header>
					<!-- a fragment, not a view - the card at the bottom of the page is
					     the one that shows the view -->
					<cards:Header title="{i18n>otDialogExample}" />
				</f:header>
				<f:content>
					<editor:CodeEditor
						value="{example>code}"
						type="{example>language}"
						height="{example>height}"
						width="100%"
						editable="false"
						lineNumbers="true"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
				</f:content>
			</f:Card>
		</VBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
