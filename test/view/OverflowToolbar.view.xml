<mvc:View
	controllerName="ui5.touch.controls.demo.controller.OverflowToolbar"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<HBox alignItems="Center" class="sapUiTinyMarginBottom">
			<Text text="Button size" width="100px" />
			<Select selectedKey="{json>/size}">
				<core:Item key="S" text="S" />
				<core:Item key="M" text="M" />
				<core:Item key="L" text="L" />
				<core:Item key="XL" text="XL" />
				<core:Item key="2XL" text="2XL" />
				<core:Item key="3XL" text="3XL" />
				<core:Item key="4XL" text="4XL" />
				<core:Item key="5XL" text="5XL" />
				<core:Item key="6XL" text="6XL" />
			</Select>
		</HBox>
		<HBox alignItems="Center" class="sapUiSmallMarginBottom">
			<Text text="Toolbar width" width="100px" />
			<Slider
				min="20"
				max="100"
				value="100"
				width="20rem"
				liveChange=".onWidthChange" />
		</HBox>

		<!-- both toolbars live in a container whose width follows the slider,
		     so the overflow behaviour can be compared directly -->
		<VBox width="{json>/containerWidth}">
			<Title text="Without priorities" class="sapUiMediumMarginTop sapUiTinyMarginBottom" />
			<tc:OverflowToolbar size="{json>/size}">
				<tc:Button
					text="New"
					icon="sap-icon://add"
					type="Emphasized"
					size="{json>/size}"
					press=".onDemoPress" />
				<tc:Button
					text="Edit"
					icon="sap-icon://edit"
					size="{json>/size}"
					press=".onDemoPress" />
				<tc:Button
					text="Copy"
					icon="sap-icon://copy"
					size="{json>/size}"
					press=".onDemoPress" />
				<tc:Button
					text="Share"
					icon="sap-icon://share"
					size="{json>/size}"
					press=".onDemoPress" />
				<ToolbarSpacer />
				<tc:Button
					text="Delete"
					icon="sap-icon://delete"
					type="Reject"
					size="{json>/size}"
					press=".onDemoPress" />
			</tc:OverflowToolbar>
			<Text text="{i18n>overflowPlainHint}" class="sapUiTinyMarginTop" />

			<Title
				text="With overflow priorities"
				class="sapUiMediumMarginTop sapUiTinyMarginBottom" />
			<tc:OverflowToolbar size="{json>/size}">
				<tc:Button
					text="Print (Low)"
					icon="sap-icon://print"
					size="{json>/size}"
					press=".onDemoPress">
					<tc:layoutData>
						<OverflowToolbarLayoutData priority="Low" />
					</tc:layoutData>
				</tc:Button>
				<tc:Button
					text="Export"
					icon="sap-icon://excel-attachment"
					size="{json>/size}"
					press=".onDemoPress" />
				<tc:Button
					text="Save (Never)"
					icon="sap-icon://save"
					type="Emphasized"
					size="{json>/size}"
					press=".onDemoPress">
					<tc:layoutData>
						<OverflowToolbarLayoutData priority="NeverOverflow" />
					</tc:layoutData>
				</tc:Button>
				<ToolbarSpacer />
				<tc:Button
					text="About (Always)"
					icon="sap-icon://hint"
					type="Ghost"
					size="{json>/size}"
					press=".onDemoPress">
					<tc:layoutData>
						<OverflowToolbarLayoutData priority="AlwaysOverflow" />
					</tc:layoutData>
				</tc:Button>
			</tc:OverflowToolbar>
			<Text text="{i18n>overflowPriorityHint}" class="sapUiTinyMarginTop" />
		</VBox>

		<Title text="As a footer" class="sapUiMediumMarginTop sapUiTinyMarginBottom" />
		<!-- the page needs an explicit height, otherwise it collapses -->
		<Page
			title="Page with an OverflowToolbar as footer"
			showFooter="true"
			class="touchControlsDemoPage">
			<footer>
				<tc:OverflowToolbar size="{json>/size}">
					<tc:Button
						text="Save"
						icon="sap-icon://save"
						type="Emphasized"
						size="{json>/size}"
						press=".onDemoPress" />
					<tc:Button
						text="Cancel"
						icon="sap-icon://decline"
						size="{json>/size}"
						press=".onDemoPress" />
					<ToolbarSpacer />
					<tc:Button
						text="Approve"
						icon="sap-icon://accept"
						type="Accept"
						size="{json>/size}"
						press=".onDemoPress" />
					<tc:Button
						text="Reject"
						icon="sap-icon://decline"
						type="Reject"
						size="{json>/size}"
						press=".onDemoPress" />
					<tc:Button
						text="History"
						icon="sap-icon://history"
						size="{json>/size}"
						press=".onDemoPress" />
				</tc:OverflowToolbar>
			</footer>
		</Page>
		<Text text="{i18n>overflowFooterHint}" class="sapUiTinyMarginTop" />

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
