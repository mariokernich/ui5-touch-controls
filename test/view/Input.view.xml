<mvc:View
	controllerName="ui5.touch.controls.demo.controller.Input"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="Input Options" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="Value" width="100px" />
							<Input
								value="{json>/value}"
								placeholder="Value"
								valueLiveUpdate="true"
								width="300px" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="Placeholder" width="100px" />
							<Input
								value="{json>/placeholder}"
								placeholder="Placeholder"
								valueLiveUpdate="true"
								width="300px" />
						</HBox>
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.ValueStateOption" type="XML" />
						<HBox alignItems="Center" wrap="Wrap">
							<Text text="Behavior" width="100px" />
							<CheckBox text="Enabled" selected="{json>/enabled}" />
							<CheckBox text="Editable" selected="{json>/editable}" />
							<CheckBox
								text="Virtual keyboard"
								selected="{json>/showVirtualKeyboard}" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="Layout" width="100px" />
							<Select
								selectedKey="{json>/layoutKey}"
								enabled="{json>/showVirtualKeyboard}"
								change=".onLayoutChange">
								<core:Item key="qwerty" text="QWERTY" />
								<core:Item key="numeric" text="Numeric" />
								<core:Item key="phone" text="Phone" />
								<core:Item key="calculator" text="Calculator" />
							</Select>
						</HBox>
						<Text text="{i18n>inputKeyboardHint}" class="sapUiTinyMarginTop" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="ui5.touch.controls.Input" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<tc:Input
							value="{json>/value}"
							placeholder="{json>/placeholder}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							showVirtualKeyboard="{json>/showVirtualKeyboard}"
							width="100%"
							liveChange=".onLiveChange">
							<tc:virtualKeyboard>
								<tc:VirtualKeyboard
									size="{json>/size}"
									layout="{json>/layout}" />
							</tc:virtualKeyboard>
						</tc:Input>
					</VBox>
				</f:content>
			</f:Card>

			<!-- the sap.m original -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="sap.m.Input" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Input
							value="{json>/value}"
							placeholder="{json>/placeholder}"
							enabled="{json>/enabled}"
							editable="{json>/editable}"
							valueState="{json>/valueState}"
							valueLiveUpdate="true"
							width="100%" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
