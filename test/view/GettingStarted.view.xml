<mvc:View
	controllerName="ui5.touch.controls.demo.controller.GettingStarted"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:editor="sap.ui.codeeditor"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<!-- hero -->
		<VBox alignItems="Center" class="sapUiMediumMarginBottom">
			<Image
				src="{app>/logo}"
				height="8rem"
				alt="ui5-touch-controls"
				densityAware="false"
				class="sapUiSmallMarginBottom" />
			<Title text="{i18n>gsTitle}" level="H1" wrapping="true" />
			<Text text="{i18n>gsSubtitle}" class="sapUiTinyMarginTop" />
		</VBox>

		<!-- what the library is about -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header title="{i18n>gsWhatTitle}" subtitle="{i18n>gsWhatSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>gsWhatText1}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<FormattedText
						htmlText="{i18n>gsWhatText2}"
						width="100%"
						class="sapUiTinyMarginTop" />
				</VBox>
			</f:content>
		</f:Card>

		<!-- live example: try the sizes -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header title="{i18n>gsSizesTitle}" subtitle="{i18n>gsSizesSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>gsSizesText}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<HBox
						wrap="Wrap"
						alignItems="Center"
						class="touchControlsCardRow sapUiTinyMarginTop">
						<tc:Button
							text="S"
							icon="sap-icon://accept"
							type="Emphasized"
							size="S"
							press=".onSizePress" />
						<tc:Button
							text="M"
							icon="sap-icon://accept"
							type="Emphasized"
							size="M"
							press=".onSizePress" />
						<tc:Button
							text="L"
							icon="sap-icon://accept"
							type="Emphasized"
							size="L"
							press=".onSizePress" />
						<tc:Button
							text="XL"
							icon="sap-icon://accept"
							type="Emphasized"
							size="XL"
							press=".onSizePress" />
						<tc:Button
							text="2XL"
							icon="sap-icon://accept"
							type="Emphasized"
							size="2XL"
							press=".onSizePress" />
						<tc:Button
							text="3XL"
							icon="sap-icon://accept"
							type="Emphasized"
							size="3XL"
							press=".onSizePress" />
					</HBox>
				</VBox>
			</f:content>
		</f:Card>

		<!-- before / after -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header
					title="{i18n>gsDropInTitle}"
					subtitle="{i18n>gsDropInSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>gsDropInText}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<HBox
						width="100%"
						wrap="Wrap"
						class="touchControlsCardRow"
						items="{example>/comparison}">
						<f:Card class="sapUiMediumMarginTop">
							<f:layoutData>
								<FlexItemData growFactor="1" baseSize="0" />
							</f:layoutData>
							<f:header>
								<cards:Header title="{example>title}" />
							</f:header>
							<f:content>
								<editor:CodeEditor
									value="{example>code}"
									type="{example>language}"
									height="{example>height}"
									width="100%"
									editable="false"
									lineNumbers="true"
									class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
							</f:content>
						</f:Card>
					</HBox>
				</VBox>
			</f:content>
		</f:Card>

		<!-- requirements -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header title="{i18n>gsRequirementsTitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<MessageStrip
						text="{i18n>gsRequirementsStrip}"
						type="Information"
						showIcon="true" />
					<FormattedText
						htmlText="{i18n>gsRequirementsText}"
						width="100%"
						class="sapUiTinyMarginTop" />
				</VBox>
			</f:content>
		</f:Card>

		<!-- next steps -->
		<f:Card class="sapUiMediumMarginBottom">
			<f:header>
				<cards:Header title="{i18n>gsNextTitle}" subtitle="{i18n>gsNextSubtitle}" />
			</f:header>
			<f:content>
				<VBox
					width="100%"
					class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
					<FormattedText
						htmlText="{i18n>gsNextText}"
						width="100%"
						class="sapUiTinyMarginTop" />
					<HBox
						wrap="Wrap"
						alignItems="Center"
						class="touchControlsCardRow sapUiSmallMarginTop">
						<Button
							text="{i18n>navSetup}"
							icon="sap-icon://wrench"
							type="Emphasized"
							press=".onSetupPress" />
						<Button
							text="{i18n>navDocumentation}"
							icon="sap-icon://documents"
							press=".onDocumentationPress" />
						<Button
							text="{i18n>btnExploreButton}"
							icon="sap-icon://navigation-right-arrow"
							iconFirst="false"
							press=".onButtonPress" />
					</HBox>
				</VBox>
			</f:content>
		</f:Card>
	</Page>
</mvc:View>
