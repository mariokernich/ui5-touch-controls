<mvc:View
	controllerName="ui5.touch.controls.demo.controller.Slider"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:cards="sap.f.cards"
	xmlns:tc="ui5.touch.controls">
	<Page showHeader="false" class="touchControlsPage">
		<HBox width="100%" class="touchControlsCardRow">
			<!-- playground -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="{i18n>optionsSlider}" />
				</f:header>
				<f:content>
					<VBox
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.SizeOption" type="XML" />
						<HBox alignItems="Center">
							<Text text="{i18n>lblMinMax}" width="110px" />
							<StepInput value="{json>/min}" min="-100" max="0" step="10" />
							<StepInput value="{json>/max}" min="10" max="1000" step="10" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblStep}" width="110px" />
							<StepInput value="{json>/step}" min="1" max="25" />
						</HBox>
						<HBox alignItems="Center" wrap="Wrap">
							<Text text="{i18n>lblAppearance}" width="110px" />
							<CheckBox text="{i18n>cbTooltip}" selected="{json>/showTooltip}" />
							<CheckBox text="{i18n>cbTickmarks}" selected="{json>/enableTickmarks}" />
							<CheckBox text="{i18n>cbEnabled}" selected="{json>/enabled}" />
						</HBox>
						<HBox alignItems="Center">
							<Text text="{i18n>lblValues}" width="110px" />
							<Text text="{json>/value} · {json>/rangeStart}–{json>/rangeEnd}" />
						</HBox>
						<core:Fragment fragmentName="ui5.touch.controls.demo.view.LastEventOption" type="XML" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the library control -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="ui5.touch.controls.Slider / RangeSlider" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<tc:Slider
							value="{json>/value}"
							min="{json>/min}"
							max="{json>/max}"
							step="{json>/step}"
							showTooltip="{json>/showTooltip}"
							enableTickmarks="{json>/enableTickmarks}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							change=".onSliderChange" />
						<tc:RangeSlider
							value="{json>/rangeStart}"
							value2="{json>/rangeEnd}"
							min="{json>/min}"
							max="{json>/max}"
							step="{json>/step}"
							showTooltip="{json>/showTooltip}"
							enableTickmarks="{json>/enableTickmarks}"
							size="{json>/size}"
							enabled="{json>/enabled}"
							change=".onRangeChange" />
					</VBox>
				</f:content>
			</f:Card>

			<!-- the sap.m original -->
			<f:Card class="sapUiMediumMarginBottom">
				<f:layoutData>
					<FlexItemData growFactor="1" baseSize="0" />
				</f:layoutData>
				<f:header>
					<cards:Header title="sap.m.Slider / RangeSlider" />
				</f:header>
				<f:content>
					<VBox
						width="100%"
						class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<Slider
							value="{json>/value}"
							min="{json>/min}"
							max="{json>/max}"
							step="{json>/step}"
							enableTickmarks="{json>/enableTickmarks}"
							enabled="{json>/enabled}"
							width="100%" />
						<RangeSlider
							range="{json>/standardRange}"
							min="{json>/min}"
							max="{json>/max}"
							step="{json>/step}"
							enableTickmarks="{json>/enableTickmarks}"
							enabled="{json>/enabled}"
							width="100%" />
					</VBox>
				</f:content>
			</f:Card>
		</HBox>

		<core:Fragment
			fragmentName="ui5.touch.controls.demo.view.ExampleCard"
			type="XML" />
	</Page>
</mvc:View>
