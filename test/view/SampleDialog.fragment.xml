<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:tc="ui5.touch.controls">
	<!-- a dialog whose footer is a touch Toolbar - the buttons aggregation of
	     sap.m.Dialog only accepts sap.m.Button, the footer takes any Toolbar -->
	<Dialog title="{i18n>sampleDialogTitle}" contentWidth="700px" contentHeight="250px">
		<VBox alignItems="Center" justifyContent="Center" height="100%">
			<Text text="{i18n>sampleDialogChangeSize}" class="sapUiTinyMarginBottom" />
			<Select selectedKey="{json>/size}">
				<core:Item key="S" text="S" />
				<core:Item key="M" text="M" />
				<core:Item key="L" text="L" />
				<core:Item key="XL" text="XL" />
				<core:Item key="2XL" text="2XL" />
				<core:Item key="3XL" text="3XL" />
				<core:Item key="4XL" text="4XL" />
				<core:Item key="5XL" text="5XL" />
				<core:Item key="6XL" text="6XL" />
			</Select>
		</VBox>
		<footer>
			<tc:Toolbar size="{json>/size}">
				<tc:Button
					text="{i18n>btnCloseDialog}"
					type="Emphasized"
					icon="sap-icon://decline"
					size="{json>/size}"
					press=".onCloseDialog" />
				<ToolbarSpacer />
				<tc:Button
					text="{i18n>btnDummy}"
					type="Ghost"
					icon="sap-icon://edit"
					size="{json>/size}"
					press=".onDummyPress" />
			</tc:Toolbar>
		</footer>
	</Dialog>
</core:FragmentDefinition>
